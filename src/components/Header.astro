---
---
  <header class="topbar">
    <div class="wrap topbar-inner">
      <a href="/" class="brand" aria-label="Padel Culture home">
        <img src="/brand/padel-culture-logo-circle.svg" alt="" width="40" height="40" />
        <span>Padel Culture</span>
      </a>
      <nav aria-label="Main">
        <a href="/#games">Games</a>
        <a href="/#guide">Padel guide</a>
        <a href="/#about">About</a>
        <a href="/#leaderboard">Leaderboard</a>
        <a href="/#faq">FAQ</a>
      </nav>
      <a class="cart-link" href="/cart" id="h-cart" hidden>Cart <span id="h-cart-n">0</span></a>
      <a class="login-link" href="/login">Log in</a>
      <a class="btn btn-solid topbar-cta" href="/join">Join as Player</a>
    </div>
  </header>
  <script type="module" is:inline>
    import * as cart from '/js/cart.js';
    const paint = () => {
      const n = cart.get().length;
      document.getElementById('h-cart').hidden = n === 0;
      document.getElementById('h-cart-n').textContent = n;
    };
    window.addEventListener('cart-change', paint);
    window.addEventListener('storage', paint);
    paint();
  </script>

<style>
  /* Top bar */
  .topbar {
    position: sticky; top: env(safe-area-inset-top, 0px); z-index: 10;
    background: color-mix(in srgb, var(--forest) 88%, transparent);
    backdrop-filter: blur(10px); border-bottom: 1px solid var(--line);
  }
  .topbar-inner { display: flex; align-items: center; gap: 1.5rem; padding-block: 0.7rem; }
  .brand { display: flex; align-items: center; gap: 0.7rem; text-decoration: none; font-family: var(--display); font-size: 1.35rem; color: var(--chalk); }
  nav { display: flex; gap: 1.6rem; margin-left: auto; }
  nav a { text-decoration: none; font-size: 0.75rem; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--mist); }
  nav a:hover { color: var(--chalk); }
  .topbar-cta { padding: 0.6rem 1.1rem; }
  .login-link { text-decoration: none; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--chalk); white-space: nowrap; }
  .login-link:hover { color: var(--olive); }
  .cart-link { display: inline-flex; align-items: center; gap: 0.4rem; text-decoration: none; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--chalk); }
  .cart-link span { display: inline-grid; place-items: center; min-width: 1.4rem; height: 1.4rem; padding-inline: 0.3rem; border-radius: 999px; background: var(--chalk); color: var(--forest); font-size: 0.7rem; letter-spacing: 0; }
  .cart-link:hover { color: var(--olive); }
  @media (max-width: 480px) { .brand span { display: none; } .topbar-inner { gap: 1rem; } }
  @media (max-width: 760px) { nav { display: none; } .cart-link { margin-left: auto; } .cart-link[hidden] + .login-link { margin-left: auto; } .login-link { letter-spacing: 0.1em; } .topbar-cta { padding: 0.6rem 0.9rem; letter-spacing: 0.1em; } }

</style>
