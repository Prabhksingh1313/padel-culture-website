---
---
  <header class="topbar">
    <div class="wrap topbar-inner">
      <a href="/" class="brand" aria-label="Padel Culture home">
        <img src="/brand/padel-culture-logo-circle.svg" alt="" width="40" height="40" />
        <span>Padel Culture</span>
      </a>
      <nav aria-label="Main">
        <a href="/#games">Games</a>
        <a href="/#how">How it works</a>
        <a href="/#about">About</a>
        <a href="/#faq">FAQ</a>
      </nav>
      <a class="btn btn-solid topbar-cta" href="/join">Join</a>
    </div>
  </header>

<style>
  /* Top bar */
  .topbar {
    position: sticky; top: env(safe-area-inset-top, 0px); z-index: 10;
    background: color-mix(in srgb, var(--forest) 88%, transparent);
    backdrop-filter: blur(10px); border-bottom: 1px solid var(--line);
  }
  .topbar-inner { display: flex; align-items: center; gap: 1.5rem; padding-block: 0.7rem; }
  .brand { display: flex; align-items: center; gap: 0.7rem; text-decoration: none; font-family: var(--display); font-size: 1.35rem; color: var(--chalk); }
  nav { display: flex; gap: 1.6rem; margin-left: auto; }
  nav a { text-decoration: none; font-size: 0.75rem; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--mist); }
  nav a:hover { color: var(--chalk); }
  .topbar-cta { padding: 0.6rem 1.1rem; }
  @media (max-width: 760px) { nav { display: none; } .topbar-cta { margin-left: auto; } }

</style>
