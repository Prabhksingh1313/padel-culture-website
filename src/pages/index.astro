---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import site from '../data/site.json';
import faqData from '../data/faq.json';
import gallery from '../data/gallery.json';
import fbConfig from '../data/firebase.json';
import fs from 'node:fs';
const hasVideo = fs.existsSync('public/video/hero.mp4');
const hasPoster = fs.existsSync('public/video/hero-poster.jpg');

const tz = 'Asia/Kolkata';
const all = await getCollection('games');
const games = all
  .filter((g) => g.data.status !== 'cancelled')
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const fmt = (d: Date, o: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat('en-IN', { timeZone: tz, ...o }).format(d);

const waBase = site.whatsappNumber
  ? `https://wa.me/${site.whatsappNumber.replace(/\D/g, '')}`
  : '';
function bookHref(g: (typeof games)[number]) {
  if (g.data.bookingLink) return g.data.bookingLink;
  const msg = `Hi Padel Culture! I'd like a spot in "${g.data.title}" on ${fmt(g.data.date, { weekday: 'long', day: 'numeric', month: 'long' })} at ${g.data.venue}.`;
  if (waBase) return `${waBase}?text=${encodeURIComponent(msg)}`;
  return site.whatsappGroupLink || site.instagram;
}
function waitHref(g: (typeof games)[number]) {
  if (!waBase) return bookHref(g);
  const msg = `Hi Padel Culture! Please add me to the waitlist for "${g.data.title}" on ${fmt(g.data.date, { weekday: 'long', day: 'numeric', month: 'long' })} at ${g.data.venue}.`;
  return `${waBase}?text=${encodeURIComponent(msg)}`;
}
const joinHref = site.whatsappGroupLink || (waBase ? `${waBase}?text=${encodeURIComponent('Hi! Please add me to the Padel Culture community.')}` : site.instagram);

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'SportsOrganization',
    name: site.name,
    sport: 'Padel',
    url: Astro.site?.toString(),
    logo: new URL('/brand/padel-culture-logo-square.png', Astro.site).toString(),
    sameAs: [site.instagram],
    areaServed: 'West Delhi, India',
  },
  ...games.map((g) => ({
    '@context': 'https://schema.org',
    '@type': 'SportsEvent',
    name: `${g.data.title} | ${site.name}`,
    sport: 'Padel',
    startDate: g.data.date.toISOString(),
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: { '@type': 'Place', name: g.data.venue, address: `${g.data.area}, Delhi, India` },
    organizer: { '@type': 'Organization', name: site.name, url: Astro.site?.toString() },
    offers: { '@type': 'Offer', price: g.data.price, priceCurrency: 'INR', url: bookHref(g), availability: g.data.status === 'full' ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock' },
  })),
];
function to12(t) { const m = /^(\d{1,2}):(\d{2})$/.exec(String(t).trim()); if (!m) return t; const h = Number(m[1]); return `${h % 12 || 12}:${m[2]} ${h < 12 ? 'am' : 'pm'}`; }

---
<Base jsonld={jsonld}>
  <Header joinHref={joinHref} />

  <main id="top">
    <!-- HERO -->
    <section class="hero">
      {hasVideo ? (
        <video class="hero-bg" autoplay muted loop playsinline preload="metadata" poster={hasPoster ? '/video/hero-poster.jpg' : undefined} aria-hidden="true">
          <source src="/video/hero-tall.mp4" type="video/mp4" media="(max-aspect-ratio: 4/5)" />
          <source src="/video/hero.mp4" type="video/mp4" />
        </video>
      ) : (
        <div class="hero-bg hero-anim" aria-hidden="true">
          <svg class="hero-court" viewBox="-40 -40 480 280">
            <g fill="none" stroke-width="1.4">
              <rect x="0" y="0" width="400" height="200" />
              <line x1="61" y1="0" x2="61" y2="200" />
              <line x1="339" y1="0" x2="339" y2="200" />
              <line x1="61" y1="100" x2="339" y2="100" />
            </g>
            <line class="net" x1="200" y1="-10" x2="200" y2="210" stroke-width="3" />
            <path class="trail" d="M 80 150 Q 200 -60 320 60 Q 200 260 90 70 Q 200 -40 330 150" fill="none" />
            <circle class="ball" r="6"><animateMotion dur="6s" repeatCount="indefinite" keyPoints="0;1;0" keyTimes="0;0.5;1" calcMode="spline" keySplines="0.45 0 0.55 1;0.45 0 0.55 1" path="M 80 150 Q 200 -60 320 60 Q 200 260 90 70 Q 200 -40 330 150" /></circle>
          </svg>
        </div>
      )}
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="wrap hero-inner">
        <p class="eyebrow">{site.tagline}</p>
        <h1>{site.heroTitle}</h1>
        <p class="lede">{site.heroText}</p>
        <div class="hero-cta">
          <a class="btn btn-play" href="/join">Join as Player</a>
          <a class="btn btn-login" href="/login">Log in</a>
        </div>
        <a class="hero-games" href="#games">See upcoming games ↓</a>
      </div>
    </section>

    <!-- GAMES -->
    <section id="games" class="games">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Fixtures</p>
          <h2>Upcoming games</h2>
          <p>Sign up solo. Partners rotate every round, and points count towards your own total.</p>
        </div>
        <ol class="board" id="board">
          {games.map((g) => {
            const taken = Math.min(g.data.spots, g.data.reserved || 0);
            const left = g.data.spots - taken;
            const full = g.data.status === 'full' || !(left > 0);
            return (
              <li class:list={['fixture', { full }]} id={`game-${g.id}`} data-start={g.data.date.toISOString()} data-id={g.id} data-spots={g.data.spots} data-reserved={g.data.reserved || 0} data-closed={g.data.status === 'full' ? '1' : ''}>
                <div class="when">
                  <span class="dow">{fmt(g.data.date, { weekday: 'short' })}</span>
                  <span class="day">{fmt(g.data.date, { day: 'numeric' })}</span>
                  <span class="mon">{fmt(g.data.date, { month: 'short' })}</span>
                </div>
                <div class="what">
                  <h3>{g.data.title}</h3>
                  <p class="meta">
                    <span>{fmt(g.data.date, { hour: 'numeric', minute: '2-digit', hour12: true })}{g.data.endTime && ` – ${to12(g.data.endTime)}`}</span>
                    <span>
                      {g.data.mapLink ? <a href={g.data.mapLink} target="_blank" rel="noopener">{g.data.venue}</a> : g.data.venue}, {g.data.area}
                    </span>
                  </p>
                  <p class="chips">
                    <span class="chip">{g.data.format}</span>
                    <span class="chip chip-level">{g.data.level}</span>
                  </p>
                </div>
                <div class="spots" aria-live="polite">
                  <span class="dots" aria-hidden="true">
                    {Array.from({ length: g.data.spots }, (_, i) => <i class:list={{ on: taken > i }} />)}
                  </span>
                  <span class="spots-label">{full ? 'Full · waitlist' : `${left} of ${g.data.spots} spots left`}</span>
                </div>
                <div class="book">
                  <span class="price">₹{g.data.price.toLocaleString('en-IN')}</span>
                  {g.data.bookingLink ? (
                    <a class="btn btn-solid" href={g.data.bookingLink} target="_blank" rel="noopener">Book spot</a>
                  ) : (
                    <>
                      <button type="button" class="btn btn-solid b-add" data-id={g.id} hidden={full}>Book spot</button>
                      <button type="button" class="btn btn-ghost b-wait" data-id={g.id} data-href={waitHref(g)} hidden={!full}>Join waitlist</button>
                    </>
                  )}
                  <span class="booked-note" hidden>Spot reserved · payment pending</span>
                  <span class="wait-note" hidden></span>
                  <button type="button" class="linkbtn b-unwait" data-id={g.id} hidden>Leave waitlist</button>
                  <button type="button" class="linkbtn b-leave" data-id={g.id} hidden>Remove me from this game</button>
                </div>
                <div class="confirm" hidden>
                  <div class="confirm-text">
                    <strong>Confirm your spot · ₹{g.data.price.toLocaleString('en-IN')}</strong>
                    <p>Your spot will be confirmed once you pay. The host will message you on WhatsApp with the payment details.</p>
                    <p class="err" hidden></p>
                  </div>
                  <div class="confirm-actions">
                    <button type="button" class="linkbtn b-back">Cancel</button>
                    <button type="button" class="btn btn-solid b-confirm" data-id={g.id}>Confirm booking</button>
                  </div>
                </div>
                <p class="booked-sub" hidden>Your spot will be confirmed once you pay. The host will message you on WhatsApp with the payment details.</p>
              </li>
            );
          })}
        </ol>
        <p class="board-empty" id="board-empty" hidden={games.length > 0}>
          No games are listed right now. New games go out on WhatsApp first: <a href={joinHref} target="_blank" rel="noopener">join the community</a>.
        </p>
      </div>
    </section>

    <!-- THIS WEEK -->
    <section id="this-week" class="week" aria-labelledby="h-week">
      <div class="wrap">
        <div class="week-head">
          <p class="eyebrow">Updated after every session</p>
          <h2 id="h-week">This week at Padel Culture</h2>
        </div>
        <div class="week-grid" id="wk-grid">
          <div class="wk wk-skel"></div><div class="wk wk-skel"></div><div class="wk wk-skel"></div><div class="wk wk-skel"></div>
        </div>
      </div>
    </section>

    <section id="gallery" class="hl" aria-labelledby="h-hl" hidden>
      <div class="wrap">
        <div class="hl-head">
          <div>
            <p class="eyebrow">Match day albums</p>
            <h2 id="h-hl">Gallery</h2>
          </div>
          <a class="btn btn-ghost" href="/gallery">All albums →</a>
        </div>
        <div class="alb-row" id="t-alb"></div>
        <div class="alb-locked" id="alb-locked" hidden>
          <p>🔒 Match day photos and videos are for Padel Culture players. Log in to see and download them.</p>
          <a class="btn btn-play" href="/login?next=%2Fgallery">Log in to view</a>
        </div>
        <p class="hl-cta"><a class="btn btn-solid" href="#games">Book the next one</a></p>
      </div>
    </section>

    <!-- PADEL GUIDE -->
    <section id="guide" class="guide-sec">
      <div class="wrap guide-grid">
        <div class="section-head">
          <p class="eyebrow">Padel guide</p>
          <h2>Everything you need before your first game</h2>
          <p>Where padel came from, how it's played, and how each of our formats works.</p>
          <div class="g-tabs" role="tablist" aria-label="Padel guide topics">
            <button type="button" role="tab" class="g-tab" id="gt-history" aria-controls="gp-history" aria-selected="true">History</button>
            <button type="button" role="tab" class="g-tab" id="gt-basics" aria-controls="gp-basics" aria-selected="false" tabindex="-1">The basics</button>
            <button type="button" role="tab" class="g-tab" id="gt-americano" aria-controls="gp-americano" aria-selected="false" tabindex="-1">Americano</button>
            <button type="button" role="tab" class="g-tab" id="gt-mexicano" aria-controls="gp-mexicano" aria-selected="false" tabindex="-1">Mexicano</button>
            <button type="button" role="tab" class="g-tab" id="gt-king" aria-controls="gp-king" aria-selected="false" tabindex="-1">King of the Court</button>
            <button type="button" role="tab" class="g-tab" id="gt-tournaments" aria-controls="gp-tournaments" aria-selected="false" tabindex="-1">Tournaments</button>
          </div>
        </div>
        <div class="g-panels">
          <div class="g-panel" role="tabpanel" id="gp-history" aria-labelledby="gt-history">
            <h3>A backyard idea that went global</h3>
            <ol>
              <li>Invented in 1969 in Acapulco, Mexico, by Enrique Corcuera, who walled in a small court at home.</li>
              <li>Taken to Spain in 1974 and Argentina in 1975, which still produce most of the world's best players.</li>
              <li>Now one of the fastest-growing sports in the world, with courts opening across India.</li>
            </ol>
            <a class="g-more" href="/learn#history">Read more in the full guide →</a>
          </div>
          <div class="g-panel" role="tabpanel" id="gp-basics" aria-labelledby="gt-basics" hidden>
            <h3>Easy to start, hard to put down</h3>
            <ol>
              <li>Always doubles, on a 20 m × 10 m court closed in by glass.</li>
              <li>Serve underarm. The ball must bounce first, then the walls are in play.</li>
              <li>Tennis scoring, but rallies last longer, so beginners play real points in their first session.</li>
            </ol>
            <a class="g-more" href="/learn#basics">Read more in the full guide →</a>
          </div>
          <div class="g-panel" role="tabpanel" id="gp-americano" aria-labelledby="gt-americano" hidden>
            <h3>Come solo, meet everyone</h3>
            <ol>
              <li>Book on your own. Partners are paired for you.</li>
              <li>Short rounds to a fixed number of points, usually 21 or 24. You switch partners every round.</li>
              <li>Every point your pair wins goes on your own tally. Most points at the end wins.</li>
            </ol>
            <a class="g-more" href="/learn#americano">Read more in the full guide →</a>
          </div>
          <div class="g-panel" role="tabpanel" id="gp-mexicano" aria-labelledby="gt-mexicano" hidden>
            <h3>Games that get closer every round</h3>
            <ol>
              <li>Round one is random, with the same scoring as an Americano.</li>
              <li>After that, the standings pick the matches: 1st and 3rd play 2nd and 4th on each court.</li>
              <li>You keep meeting players at your level, so the last rounds are the tightest.</li>
            </ol>
            <a class="g-more" href="/learn#mexicano">Read more in the full guide →</a>
          </div>
          <div class="g-panel" role="tabpanel" id="gp-king" aria-labelledby="gt-king" hidden>
            <h3>Win and climb, lose and drop</h3>
            <ol>
              <li>Courts are ranked, with the King's court at the top.</li>
              <li>Short timed rounds. Winners move up a court, losers move down.</li>
              <li>Whoever finishes on the King's court, or wins the most rounds there, takes the night.</li>
            </ol>
            <a class="g-more" href="/learn#king">Read more in the full guide →</a>
          </div>
          <div class="g-panel" role="tabpanel" id="gp-tournaments" aria-labelledby="gt-tournaments" hidden>
            <h3>Fixed pairs, proper competition</h3>
            <ol>
              <li>Enter with a partner and keep them throughout.</li>
              <li>A group stage first, so nobody goes home after one match.</li>
              <li>Then knockouts to a final, with games, sets and a golden point at deuce.</li>
            </ol>
            <a class="g-more" href="/learn#tournaments">Read more in the full guide →</a>
          </div>
        </div>
      </div>
    </section>

    {gallery.photos.length > 0 && (
      <section class="gallery" aria-label="Photos from our games">
        <div class="wrap gallery-grid">
          {(gallery.photos as { image: string; caption?: string }[]).map((p) => (
            <figure><img src={p.image} alt={p.caption || 'Padel Culture game'} loading="lazy" />{p.caption && <figcaption>{p.caption}</figcaption>}</figure>
          ))}
        </div>
      </section>
    )}

    <!-- ABOUT + VENUES -->
    <section id="about" class="about">
      <div class="wrap about-grid">
        <div class="about-copy">
          <p class="eyebrow">About</p>
          <h2>Courts were here. The community wasn't.</h2>
          <p>{site.about}</p>
        </div>
      </div>
    </section>

    <!-- LEADERBOARD -->
    <section id="leaderboard" class="lb-sec">
      <div class="wrap lb-grid">
        <div class="section-head">
          <p class="eyebrow">Padel Culture Rating</p>
          <h2>Who's on top</h2>
          <p>Every player gets a Padel Culture Rating from 0 to 7, the same range as Playtomic, and a level from Beginner to Elite. A short questionnaire sets your start. After that, every session moves you, based on the points you win against the level of your partners and opponents.</p>
          <ul class="lb-tiers" aria-label="Levels">
            <li>Beginner (0.0–0.9)</li><li>Beginner+ (1.0–1.9)</li><li>Intermediate (2.0–2.9)</li><li>Intermediate+ (3.0–3.9)</li><li>Lower Advanced (4.0–4.9)</li><li>Advanced (5.0–5.9)</li><li>Elite (6.0–7.0)</li>
          </ul>
          <div class="hero-cta">
            <a class="btn btn-solid" href="/leaderboard">Full leaderboard</a>
            <a class="btn btn-ghost" href="/join">Get your rating</a>
          </div>
        </div>
        <div class="lb-top">
          <p class="lb-top-title">Top players</p>
          <ol id="lb-top"><li class="muted">Loading…</li></ol>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="faq">
      <div class="wrap faq-grid">
        <div class="section-head">
          <p class="eyebrow">Questions</p>
          <h2>Before your first game</h2>
        </div>
        <div class="faq-list">
          {faqData.items.map((f, i) => (
            <details id={`faq-${i}`}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- JOIN -->
    <section class="join">
      <div class="wrap join-inner">
        <img src="/brand/padel-culture-logo-circle.svg" alt="Padel Culture" width="180" height="180" />
        <h2>Games fill up on WhatsApp first.</h2>
        <p>Join the community to hear about new Americanos, beginner sessions and tournaments in West Delhi before they're posted anywhere else.</p>
        <div class="hero-cta">
          {site.whatsappGroupLink && <a class="btn btn-solid" href={site.whatsappGroupLink} target="_blank" rel="noopener">Join the WhatsApp community</a>}
          <a class={site.whatsappGroupLink ? 'btn btn-ghost' : 'btn btn-solid'} href="/join">Sign up and get rated</a>
          <a class="btn btn-ghost" href={site.instagram} target="_blank" rel="noopener">Instagram {site.instagramHandle}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script type="application/json" id="fb-config" set:html={JSON.stringify(fbConfig)} />

  <script is:inline>
    (() => {
      const v = document.querySelector('video.hero-bg');
      if (v && matchMedia('(prefers-reduced-motion: reduce)').matches) { v.removeAttribute('autoplay'); v.pause(); }
    })();
    (() => {
      const tabs = [...document.querySelectorAll('.g-tab')];
      const pick = (t, focus) => {
        tabs.forEach((x) => {
          const on = x === t;
          x.setAttribute('aria-selected', String(on));
          x.tabIndex = on ? 0 : -1;
          document.getElementById(x.getAttribute('aria-controls')).hidden = !on;
        });
        if (focus) t.focus();
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => pick(t));
        t.addEventListener('keydown', (e) => {
          const d = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
          if (d) { e.preventDefault(); pick(tabs[(i + d + tabs.length) % tabs.length], true); }
        });
      });
      // Deep links from the menu: #guide-<topic> opens a guide tab, #faq-<n> opens a question.
      const follow = () => {
        const h = decodeURIComponent(location.hash.replace('#', ''));
        if (h.startsWith('guide-')) {
          const t = tabs.find((x) => x.id === 'gt-' + h.slice(6));
          if (t) pick(t);
          document.getElementById('guide').scrollIntoView();
        } else if (h.startsWith('faq-')) {
          const d = document.getElementById(h);
          if (d) { d.open = true; d.scrollIntoView({ block: 'center' }); }
        }
      };
      follow();
      window.addEventListener('hashchange', follow);
    })();
  </script>

  <script type="module" is:inline>
    const $ = (id) => document.getElementById(id);
    const rows = [...document.querySelectorAll('#board .fixture')];

    // Hide games that have already started.
    const now = Date.now();
    let shown = 0;
    rows.forEach((r) => {
      const t = Date.parse(r.dataset.start);
      if (t && t + 3 * 3600e3 < now) r.hidden = true; else shown++;
    });
    if (rows.length && !shown) $('board-empty').hidden = false;

    const booked = {};   // gameId -> online bookings (live)
    const mine = new Set();
    let waitlist = [];   // every waitlist entry, oldest first
    let myUid = null;
    let confirming = null;   // game the player is confirming
    let fbm = null, me = null, authReady = false;

    function paint() {
      rows.forEach((r) => {
        const id = r.dataset.id;
        const spots = +r.dataset.spots;
        const taken = Math.min(spots, (+r.dataset.reserved || 0) + (booked[id] || 0));
        const left = spots - taken;
        const full = r.dataset.closed === '1' || left <= 0;
        r.classList.toggle('full', full);
        r.querySelectorAll('.dots i').forEach((d, i) => d.classList.toggle('on', i < taken));
        const queue = waitlist.filter((w) => w.gameId === id);
        const myPlace = myUid ? queue.findIndex((w) => w.uid === myUid) + 1 : 0;
        r.querySelector('.spots-label').textContent = full ? (queue.length ? `Full · ${queue.length} on waitlist` : 'Full · waitlist open') : `${left} of ${spots} spot${spots === 1 ? '' : 's'} left`;
        const add = r.querySelector('.b-add');
        const wait = r.querySelector('.b-wait');
        const note = r.querySelector('.booked-note');
        const isMine = mine.has(id);
        if (note) note.hidden = !isMine;
        const sub = r.querySelector('.booked-sub');
        if (sub) sub.hidden = !isMine;
        const box = r.querySelector('.confirm');
        if (box) box.hidden = !(confirming === id && !isMine && !full);
        const leave = r.querySelector('.b-leave');
        if (leave) {
          leave.hidden = !isMine;
          if (!isMine) { leave.dataset.confirming = ''; leave.disabled = false; leave.textContent = 'Remove me from this game'; }
        }
        if (add) {
          add.hidden = full || isMine || confirming === id;
        }
        const onWait = myPlace > 0 && !isMine;
        if (wait) wait.hidden = !full || isMine || onWait;
        const wnote = r.querySelector('.wait-note');
        if (wnote) {
          wnote.hidden = !onWait;
          wnote.textContent = full ? `You're #${myPlace} on the waitlist` : 'A spot has opened. Book it before it goes.';
        }
        const unwait = r.querySelector('.b-unwait');
        if (unwait) unwait.hidden = !onWait;
      });
    }

    // Book spot -> confirm on the card (log in first if needed).
    document.querySelectorAll('.b-add').forEach((b) => b.addEventListener('click', () => {
      if (!fbm || !authReady) return;
      if (!me) { location.href = '/join?next=' + encodeURIComponent('/#games'); return; }
      confirming = b.dataset.id;
      paint();
    }));
    document.querySelectorAll('.b-back').forEach((b) => b.addEventListener('click', () => { confirming = null; paint(); }));
    document.querySelectorAll('.b-confirm').forEach((b) => b.addEventListener('click', async () => {
      const id = b.dataset.id;
      const row = b.closest('.fixture');
      const errEl = row.querySelector('.confirm .err');
      errEl.hidden = true;
      b.disabled = true; b.textContent = 'Booking…';
      try {
        const { displayName } = await import('/js/rating.js');
        const p = await fbm.getPlayer(me.uid);
        await fbm.bookGame(me, displayName((p && p.name) || 'Player'), id, +row.dataset.spots);
        mine.add(id);
        booked[id] = (booked[id] || 0) + 1;
        confirming = null;
        waitlist = waitlist.filter((w) => !(w.gameId === id && w.uid === me.uid));
        fbm.leaveWaitlist(me.uid, id).catch(() => {});
      } catch (e) {
        console.error(e);
        errEl.textContent = fbm.friendlyError(e);
        errEl.hidden = false;
        if (e.code === 'already-booked') { mine.add(id); confirming = null; }
      }
      b.disabled = false; b.textContent = 'Confirm booking';
      paint();
    }));
    paint();

    // ---------- This week at Padel Culture ----------
    function renderWeek(raw, counts, RT) {
      const esc = (v) => String(v ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      const weekAgo = Date.now() - 7 * 864e5;
      const list = raw.map((r) => { const rating = RT.normRating(r); return { ...r, rating, tier: RT.tierFor(rating).name }; });
      const recent = list.filter((r) => typeof r.lastSessionAt === 'number' && r.lastSessionAt >= weekAgo);
      const cards = [];
      const climber = recent.filter((r) => typeof r.lastDelta === 'number' && r.lastDelta > 0).sort((a, b) => b.lastDelta - a.lastDelta)[0];
      if (climber) cards.push({ k: 'Biggest climber', big: `▲ +${climber.lastDelta.toFixed(2)}`, name: climber.name, sub: `${RT.show1(climber.rating)} · ${climber.tier}` });
      const star = recent.filter((r) => typeof r.lastPerf === 'number' && r.lastPerf > 0 && r !== climber).sort((a, b) => b.lastPerf - a.lastPerf)[0]
        || recent.filter((r) => typeof r.lastPerf === 'number' && r.lastPerf > 0).sort((a, b) => b.lastPerf - a.lastPerf)[0];
      if (star) cards.push({ k: 'Player of the session', big: `+${Math.round(star.lastPerf * 100)}%`, name: star.name, sub: `above expected · ${esc(star.lastSessionTitle || 'last session')}` });
      const streak = list.filter((r) => Array.isArray(r.form) && r.form.length >= 3 && r.form.slice(0, 3).every((b) => b === 'up')).sort((a, b) => b.rating - a.rating);
      if (streak.length) cards.push({ k: 'On a hot streak', big: '▲▲▲', name: streak.slice(0, 3).map((r) => r.name).join(', '), sub: streak.length > 3 ? `and ${streak.length - 3} more` : 'three sessions above expected' });
      // Next game filling up
      const nextRow = rows.filter((r) => !r.hidden && Date.parse(r.dataset.start) > Date.now()).sort((a, b) => Date.parse(a.dataset.start) - Date.parse(b.dataset.start))[0];
      if (nextRow) {
        const id = nextRow.dataset.id, spots = +nextRow.dataset.spots;
        const taken = Math.min(spots, (+nextRow.dataset.reserved || 0) + ((counts[id] && counts[id].booked) || 0));
        const title = nextRow.querySelector('.what h3') ? nextRow.querySelector('.what h3').textContent : 'Next game';
        cards.push({ k: 'Next game', big: `${taken}/${spots}`, name: title, sub: taken >= spots ? 'Full · join the waitlist' : `${spots - taken} spot${spots - taken === 1 ? '' : 's'} left`, href: '#games', cta: taken >= spots ? 'Join waitlist' : 'Book now' });
      }
      const proven = list.filter((r) => r.status === 'verified').length;
      cards.push({ k: 'The community', big: String(list.length), name: `rated player${list.length === 1 ? '' : 's'}`, sub: proven ? `${proven} Court-Proven` : 'Get rated in 2 minutes', href: list.length ? '/leaderboard' : '/join', cta: list.length ? 'See the leaderboard' : 'Get your rating' });
      if (!climber && !star && !streak.length) cards.splice(cards.length - 1, 0, { k: 'Coming up', big: '▲', name: 'Weekly highlights', sub: 'Biggest climber and player of the session appear here after the next rated session.' });
      $('wk-grid').innerHTML = cards.slice(0, 4).map((c) => `<${c.href ? `a href="${c.href}"` : 'div'} class="wk">
          <span class="wk-k">${esc(c.k)}</span>
          <span class="wk-big">${esc(c.big)}</span>
          <span class="wk-name">${esc(c.name)}</span>
          <span class="wk-sub">${c.sub}</span>
          ${c.cta ? `<span class="wk-cta">${esc(c.cta)} →</span>` : ''}
        </${c.href ? 'a' : 'div'}>`).join('');
    }

    // Live spot counts and the player's own bookings.
    const cfg = JSON.parse($('fb-config').textContent);
    if (!cfg.apiKey) import('/js/rating.js').then((RT) => renderWeek([], {}, RT));
    if (cfg.apiKey) {
      try {
        const fb = await import('/js/firebase.js');
        fbm = fb;
        const loadAlbums = () => fb.listAlbums().then((albums) => {
          const list = albums.filter((a) => a.count > 0).slice(0, 4);
          if (!list.length) return;
          const esc = (v) => String(v ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
          const dt = (d) => d ? new Date(d + 'T12:00:00+05:30').toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short' }) : '';
          $('t-alb').innerHTML = list.map((a) => `<a class="alb" href="/gallery?a=${encodeURIComponent(a.id)}">
              <span class="alb-cover">${a.cover ? `<img src="${esc(a.cover)}" alt="" loading="lazy" />` : '<span class="hl-blank"></span>'}<span class="hl-chip">${a.count} ${a.count === 1 ? 'item' : 'items'}</span></span>
              <span class="alb-t">${esc(a.title)}</span><span class="alb-d">${esc(dt(a.date))}${a.venue ? ' · ' + esc(a.venue) : ''}</span></a>`).join('');
          $('gallery').hidden = false;
        }).catch((e) => console.error(e));
        fb.watchUser((u) => {
          if (u) { $('alb-locked').hidden = true; loadAlbums(); }
          else { $('t-alb').innerHTML = ''; $('alb-locked').hidden = false; $('gallery').hidden = false; }
        });
        const RT = await import('/js/rating.js');
        const lbPromise = fb.listLeaderboard();
        Promise.all([lbPromise, fb.listGameCounts().catch(() => ({}))]).then(([raw, counts]) => renderWeek(raw, counts, RT)).catch((e) => { console.error(e); renderWeek([], {}, RT); });
        lbPromise.then((raw) => {
          const list = raw.map((r) => { const rating = RT.normRating(r); return { ...r, rating, tier: RT.tierFor(rating).name }; }).sort((a, b) => b.rating - a.rating);
          const esc = (v) => String(v ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
          $('lb-top').innerHTML = list.length
            ? list.slice(0, 5).map((r, i) => `<li><span class="lb-rank">${i + 1}</span><span class="lb-name">${esc(r.name)}</span><span class="lb-tier">${esc(r.tier)}</span><span class="lb-num">${RT.show1(r.rating)}</span></li>`).join('')
            : '<li class="muted">No ratings yet. <a href="/join">Be the first.</a></li>';
        }).catch((e) => { console.error(e); $('lb-top').innerHTML = '<li class="muted"><a href="/leaderboard">See the leaderboard</a></li>'; });
        const counts = await fb.listGameCounts();
        Object.entries(counts).forEach(([id, g]) => { booked[id] = g.booked || 0; });
        paint();
        document.querySelectorAll('.b-leave').forEach((b) => b.addEventListener('click', async () => {
          if (!me) return;
          if (b.dataset.confirming !== '1') {
            b.dataset.confirming = '1';
            b.textContent = 'Tap again to remove';
            setTimeout(() => { if (b.dataset.confirming === '1' && !b.disabled) { b.dataset.confirming = ''; b.textContent = 'Remove me from this game'; } }, 5000);
            return;
          }
          b.disabled = true;
          b.textContent = 'Removing…';
          try {
            await fb.cancelBooking(me, b.dataset.id);
            mine.delete(b.dataset.id);
            booked[b.dataset.id] = Math.max(0, (booked[b.dataset.id] || 1) - 1);
            paint();
          } catch (e) {
            console.error(e);
            b.disabled = false;
            b.dataset.confirming = '';
            b.textContent = 'Couldn\'t remove you. Try again';
          }
        }));
        try { waitlist = await fb.listWaitlist(); } catch (e) { console.error(e); }
        paint();
        document.querySelectorAll('.b-wait').forEach((b) => b.addEventListener('click', async () => {
          if (!me) { location.href = '/join?next=/'; return; }
          b.disabled = true;
          try {
            const { displayName } = await import('/js/rating.js');
            const p = await fb.getPlayer(me.uid);
            const name = displayName((p && p.name) || 'Player');
            await fb.joinWaitlist(me, name, b.dataset.id);
            waitlist.push({ gameId: b.dataset.id, uid: me.uid, name });
            paint();
          } catch (e) {
            console.error(e);
            // If the on-site waitlist isn't available, fall back to a WhatsApp message.
            window.open(b.dataset.href, '_blank', 'noopener');
          }
          b.disabled = false;
        }));
        document.querySelectorAll('.b-unwait').forEach((b) => b.addEventListener('click', async () => {
          if (!me) return;
          b.disabled = true;
          try {
            await fb.leaveWaitlist(me.uid, b.dataset.id);
            waitlist = waitlist.filter((w) => !(w.gameId === b.dataset.id && w.uid === me.uid));
            paint();
          } catch (e) { console.error(e); }
          b.disabled = false;
        }));
        fb.watchUser(async (user) => {
          me = user;
          authReady = true;
          myUid = user ? user.uid : null;
          mine.clear();
          if (user) {
            try { (await fb.listMyBookings(user.uid)).forEach((b) => mine.add(b.gameId)); } catch (e) { console.error(e); }
            // Once a waitlisted player has a spot, take them off the waitlist.
            for (const w of waitlist.filter((x) => x.uid === user.uid && mine.has(x.gameId))) {
              try { await fb.leaveWaitlist(user.uid, w.gameId); waitlist = waitlist.filter((x) => x !== w); } catch (e) { console.error(e); }
            }
          }
          paint();
        });
      } catch (e) { console.error(e); }
    }
  </script>
</Base>

