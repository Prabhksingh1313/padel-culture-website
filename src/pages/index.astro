---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import site from '../data/site.json';
import faqData from '../data/faq.json';
import gallery from '../data/gallery.json';
import fbConfig from '../data/firebase.json';

const tz = 'Asia/Kolkata';
const all = await getCollection('games');
const games = all
  .filter((g) => g.data.status !== 'cancelled')
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const fmt = (d: Date, o: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat('en-IN', { timeZone: tz, ...o }).format(d);

const waBase = site.whatsappNumber
  ? `https://wa.me/${site.whatsappNumber.replace(/\D/g, '')}`
  : '';
function bookHref(g: (typeof games)[number]) {
  if (g.data.bookingLink) return g.data.bookingLink;
  const msg = `Hi Padel Culture! I'd like a spot in "${g.data.title}" on ${fmt(g.data.date, { weekday: 'long', day: 'numeric', month: 'long' })} at ${g.data.venue}.`;
  if (waBase) return `${waBase}?text=${encodeURIComponent(msg)}`;
  return site.whatsappGroupLink || site.instagram;
}
const joinHref = site.whatsappGroupLink || (waBase ? `${waBase}?text=${encodeURIComponent('Hi! Please add me to the Padel Culture community.')}` : site.instagram);

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'SportsOrganization',
    name: site.name,
    sport: 'Padel',
    url: Astro.site?.toString(),
    logo: new URL('/brand/padel-culture-logo-square.png', Astro.site).toString(),
    sameAs: [site.instagram],
    areaServed: 'West Delhi, India',
  },
  ...games.map((g) => ({
    '@context': 'https://schema.org',
    '@type': 'SportsEvent',
    name: `${g.data.title} | ${site.name}`,
    sport: 'Padel',
    startDate: g.data.date.toISOString(),
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: { '@type': 'Place', name: g.data.venue, address: `${g.data.area}, Delhi, India` },
    organizer: { '@type': 'Organization', name: site.name, url: Astro.site?.toString() },
    offers: { '@type': 'Offer', price: g.data.price, priceCurrency: 'INR', url: bookHref(g), availability: g.data.status === 'full' ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock' },
  })),
];
---
<Base jsonld={jsonld}>
  <Header joinHref={joinHref} />

  <main id="top">
    <!-- HERO -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">{site.tagline}</p>
          <h1>{site.heroTitle}</h1>
          <p class="lede">{site.heroText}</p>
          <div class="hero-cta">
            <a class="btn btn-solid" href="#games">See upcoming games</a>
            <a class="btn btn-ghost" href="/join">Join the community</a>
          </div>
        </div>
        <figure class="court" aria-label="Top-down diagram of a padel court, 20 by 10 metres">
          <svg viewBox="-30 -30 460 270" role="img">
            <title>Padel court, 20 m × 10 m</title>
            <g fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="0" y="0" width="400" height="200" />
              <line x1="61" y1="0" x2="61" y2="200" />
              <line x1="339" y1="0" x2="339" y2="200" />
              <line x1="61" y1="100" x2="339" y2="100" />
            </g>
            <line class="net" x1="200" y1="-8" x2="200" y2="208" stroke-width="3" />
            <circle class="ball" cx="268" cy="62" r="5" />
            <g class="dims" font-size="11" letter-spacing="2">
              <line x1="0" y1="-16" x2="400" y2="-16" stroke-width="0.75" />
              <text x="200" y="-21" text-anchor="middle">20 M</text>
              <line x1="416" y1="0" x2="416" y2="200" stroke-width="0.75" />
              <text x="424" y="104" transform="rotate(90 424 104)" text-anchor="middle">10 M</text>
              <text x="130" y="224" text-anchor="middle">SERVICE LINE · 6.95 M FROM NET</text>
            </g>
          </svg>
        </figure>
      </div>
      <div class="wrap areas" aria-label="Areas we play in">
        {site.areas.map((a) => <span>{a}</span>)}
      </div>
    </section>

    <!-- GAMES -->
    <section id="games" class="games">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Fixtures</p>
          <h2>Upcoming games</h2>
          <p>Sign up solo. Partners rotate every round, and points count towards your own total.</p>
        </div>
        <ol class="board" id="board">
          {games.map((g) => {
            const taken = Math.min(g.data.spots, g.data.reserved || 0);
            const left = g.data.spots - taken;
            const full = g.data.status === 'full' || !(left > 0);
            return (
              <li class:list={['fixture', { full }]} data-start={g.data.date.toISOString()} data-id={g.id} data-spots={g.data.spots} data-reserved={g.data.reserved || 0} data-closed={g.data.status === 'full' ? '1' : ''}>
                <div class="when">
                  <span class="dow">{fmt(g.data.date, { weekday: 'short' })}</span>
                  <span class="day">{fmt(g.data.date, { day: 'numeric' })}</span>
                  <span class="mon">{fmt(g.data.date, { month: 'short' })}</span>
                </div>
                <div class="what">
                  <h3>{g.data.title}</h3>
                  <p class="meta">
                    <span>{fmt(g.data.date, { hour: 'numeric', minute: '2-digit', hour12: true })}{g.data.endTime && ` – ${g.data.endTime}`}</span>
                    <span>
                      {g.data.mapLink ? <a href={g.data.mapLink} target="_blank" rel="noopener">{g.data.venue}</a> : g.data.venue}, {g.data.area}
                    </span>
                  </p>
                  <p class="chips">
                    <span class="chip">{g.data.format}</span>
                    <span class="chip chip-level">{g.data.level}</span>
                  </p>
                </div>
                <div class="spots" aria-live="polite">
                  <span class="dots" aria-hidden="true">
                    {Array.from({ length: g.data.spots }, (_, i) => <i class:list={{ on: taken > i }} />)}
                  </span>
                  <span class="spots-label">{full ? 'Full · waitlist' : `${left} of ${g.data.spots} spots left`}</span>
                </div>
                <div class="book">
                  <span class="price">₹{g.data.price.toLocaleString('en-IN')}</span>
                  {g.data.bookingLink ? (
                    <a class="btn btn-solid" href={g.data.bookingLink} target="_blank" rel="noopener">Book spot</a>
                  ) : (
                    <>
                      <button type="button" class="btn btn-solid b-add" data-id={g.id} hidden={full}>Book spot</button>
                      <a class="btn btn-ghost b-wait" href={bookHref(g)} target="_blank" rel="noopener" hidden={!full}>Join waitlist</a>
                    </>
                  )}
                  <span class="booked-note" hidden>You're booked ✓</span>
                  <button type="button" class="linkbtn b-leave" data-id={g.id} hidden>Remove me from this game</button>
                </div>
              </li>
            );
          })}
        </ol>
        <p class="board-empty" id="board-empty" hidden={games.length > 0}>
          No games are listed right now. New games go out on WhatsApp first: <a href={joinHref} target="_blank" rel="noopener">join the community</a>.
        </p>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section id="how" class="how">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">The format</p>
          <h2>How an Americano works</h2>
        </div>
        <ol class="steps">
          <li>
            <h3>Book a spot on your own</h3>
            <p>Pick a game at your level. You don't need a partner or a group; most people come solo.</p>
          </li>
          <li>
            <h3>Rotate partners each round</h3>
            <p>Rounds are short, usually to 21 or 24 points. After each one you switch partners and opponents.</p>
          </li>
          <li>
            <h3>Points go on your own tally</h3>
            <p>Every point you win counts for you. The leaderboard is up at the end, then it's chai and photos.</p>
          </li>
        </ol>
      </div>
    </section>

    {gallery.photos.length > 0 && (
      <section class="gallery" aria-label="Photos from our games">
        <div class="wrap gallery-grid">
          {(gallery.photos as { image: string; caption?: string }[]).map((p) => (
            <figure><img src={p.image} alt={p.caption || 'Padel Culture game'} loading="lazy" />{p.caption && <figcaption>{p.caption}</figcaption>}</figure>
          ))}
        </div>
      </section>
    )}

    <!-- ABOUT + VENUES -->
    <section id="about" class="about">
      <div class="wrap about-grid">
        <div class="about-copy">
          <p class="eyebrow">About</p>
          <h2>Courts were here. The community wasn't.</h2>
          <p>{site.about}</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="faq">
      <div class="wrap faq-grid">
        <div class="section-head">
          <p class="eyebrow">Questions</p>
          <h2>Before your first game</h2>
        </div>
        <div class="faq-list">
          {faqData.items.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- JOIN -->
    <section class="join">
      <div class="wrap join-inner">
        <h2>Games fill up on WhatsApp first.</h2>
        <p>Join the community to hear about new Americanos, beginner sessions and tournaments in West Delhi before they're posted anywhere else.</p>
        <div class="hero-cta">
          <a class="btn btn-solid" href="/join">Join the community</a>
          <a class="btn btn-ghost" href={site.instagram} target="_blank" rel="noopener">Instagram {site.instagramHandle}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script type="application/json" id="fb-config" set:html={JSON.stringify(fbConfig)} />
  <script type="module" is:inline>
    import * as cart from '/js/cart.js';
    const $ = (id) => document.getElementById(id);
    const rows = [...document.querySelectorAll('#board .fixture')];

    // Hide games that have already started.
    const now = Date.now();
    let shown = 0;
    rows.forEach((r) => {
      const t = Date.parse(r.dataset.start);
      if (t && t + 3 * 3600e3 < now) r.hidden = true; else shown++;
    });
    if (rows.length && !shown) $('board-empty').hidden = false;

    const booked = {};   // gameId -> online bookings (live)
    const mine = new Set();

    function paint() {
      const inCart = new Set(cart.get());
      rows.forEach((r) => {
        const id = r.dataset.id;
        const spots = +r.dataset.spots;
        const taken = Math.min(spots, (+r.dataset.reserved || 0) + (booked[id] || 0));
        const left = spots - taken;
        const full = r.dataset.closed === '1' || left <= 0;
        r.classList.toggle('full', full);
        r.querySelectorAll('.dots i').forEach((d, i) => d.classList.toggle('on', i < taken));
        r.querySelector('.spots-label').textContent = full ? 'Full · waitlist' : `${left} of ${spots} spot${spots === 1 ? '' : 's'} left`;
        const add = r.querySelector('.b-add');
        const wait = r.querySelector('.b-wait');
        const note = r.querySelector('.booked-note');
        const isMine = mine.has(id);
        if (note) note.hidden = !isMine;
        const leave = r.querySelector('.b-leave');
        if (leave) {
          leave.hidden = !isMine;
          if (!isMine) { leave.dataset.confirming = ''; leave.disabled = false; leave.textContent = 'Remove me from this game'; }
        }
        if (add) {
          add.hidden = full || isMine;
          add.textContent = inCart.has(id) ? 'In cart · View' : 'Book spot';
          add.classList.toggle('btn-ghost', inCart.has(id));
          add.classList.toggle('btn-solid', !inCart.has(id));
        }
        if (wait) wait.hidden = !full || isMine;
      });
    }

    document.querySelectorAll('.b-add').forEach((b) => b.addEventListener('click', () => {
      const id = b.dataset.id;
      if (cart.get().includes(id)) { location.href = '/cart'; return; }
      cart.add(id);
      paint();
    }));
    window.addEventListener('cart-change', paint);
    paint();

    // Live spot counts and the player's own bookings.
    const cfg = JSON.parse($('fb-config').textContent);
    if (cfg.apiKey) {
      try {
        const fb = await import('/js/firebase.js');
        const counts = await fb.listGameCounts();
        Object.entries(counts).forEach(([id, g]) => { booked[id] = g.booked || 0; });
        paint();
        let me = null;
        document.querySelectorAll('.b-leave').forEach((b) => b.addEventListener('click', async () => {
          if (!me) return;
          if (b.dataset.confirming !== '1') {
            b.dataset.confirming = '1';
            b.textContent = 'Tap again to confirm';
            setTimeout(() => { if (b.dataset.confirming === '1' && !b.disabled) { b.dataset.confirming = ''; b.textContent = 'Remove me from this game'; } }, 5000);
            return;
          }
          b.disabled = true;
          b.textContent = 'Removing…';
          try {
            await fb.cancelBooking(me, b.dataset.id);
            mine.delete(b.dataset.id);
            booked[b.dataset.id] = Math.max(0, (booked[b.dataset.id] || 1) - 1);
            paint();
          } catch (e) {
            console.error(e);
            b.disabled = false;
            b.dataset.confirming = '';
            b.textContent = 'Couldn\'t remove you. Try again';
          }
        }));
        fb.watchUser(async (user) => {
          me = user;
          mine.clear();
          if (user) {
            try { (await fb.listMyBookings(user.uid)).forEach((b) => mine.add(b.gameId)); } catch (e) { console.error(e); }
          }
          paint();
        });
      } catch (e) { console.error(e); }
    }
  </script>
</Base>

<style>
  /* Hero */
  .hero { padding-block: clamp(3rem, 8vw, 6rem) 2.5rem; }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .hero-copy { display: grid; gap: 1.4rem; min-width: 0; }
  .hero h1 { font-size: clamp(3.2rem, 9vw, 6.5rem); font-weight: 500; letter-spacing: -0.01em; }
  .lede { color: var(--mist); font-size: 1.05rem; max-width: 34rem; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .court { margin: 0; color: var(--olive); min-width: 0; }
  .court svg { width: 100%; height: auto; overflow: visible; }
  .court .net { stroke: var(--sage); }
  .court .ball { fill: var(--sage); }
  .court .dims { fill: var(--mist); stroke: var(--line); font-family: var(--body); }
  .court .dims text { stroke: none; }
  @media (prefers-reduced-motion: no-preference) {
    .court .ball { animation: rally 7s ease-in-out infinite; }
    @keyframes rally {
      0%, 100% { transform: translate(0, 0); }
      25% { transform: translate(-150px, 70px); }
      50% { transform: translate(40px, 110px); }
      75% { transform: translate(-120px, 10px); }
    }
  }
  .areas { display: flex; flex-wrap: wrap; gap: 0.5rem 1.6rem; margin-top: clamp(2.5rem, 6vw, 4rem); padding-top: 1.4rem; border-top: 1px solid var(--line); }
  .areas span { font-size: 0.72rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--mist); }
  @media (max-width: 860px) { .hero-grid { grid-template-columns: 1fr; } }

  /* Fixture board */
  .games { background: var(--pine); border-block: 1px solid var(--line); }
  .board { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .fixture {
    display: grid; grid-template-columns: 5.5rem minmax(0, 1fr) 12rem 10rem; gap: 1.5rem; align-items: center;
    padding-block: 1.6rem; border-bottom: 1px solid var(--line);
  }
  .when { display: grid; justify-items: start; line-height: 1; gap: 0.25rem; }
  .dow, .mon { font-size: 0.7rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--olive); font-weight: 600; }
  .day { font-family: var(--display); font-size: 3.2rem; font-variant-numeric: lining-nums tabular-nums; }
  .what { display: grid; gap: 0.45rem; min-width: 0; }
  .what h3 { font-size: 1.7rem; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.2rem 1.2rem; color: var(--mist); font-size: 0.9rem; }
  .meta a { color: var(--sage); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chip { font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; padding: 0.3rem 0.6rem; border: 1px solid var(--line); border-radius: 999px; color: var(--sage); }
  .chip-level { background: var(--moss); border-color: transparent; color: var(--chalk); }
  .spots { display: grid; gap: 0.5rem; }
  .dots { display: flex; flex-wrap: wrap; gap: 4px; max-width: 6.5rem; }
  .dots i { width: 9px; height: 9px; border-radius: 50%; border: 1px solid var(--olive); }
  .dots i.on { background: var(--olive); }
  .spots-label { font-size: 0.78rem; color: var(--mist); font-variant-numeric: tabular-nums; }
  .book { display: grid; gap: 0.6rem; justify-items: end; }
  .price { font-family: var(--display); font-size: 1.7rem; font-variant-numeric: lining-nums; }
  .fixture.full .what h3, .fixture.full .price { color: var(--mist); }
  .b-leave { background: none; border: 0; padding: 0; font: inherit; font-size: 0.8rem; color: var(--sage); text-decoration: underline; cursor: pointer; }
  .b-leave:disabled { opacity: 0.6; cursor: progress; }
  .booked-note { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sage); }
  .board-empty { padding-block: 2rem; color: var(--mist); }
  .board-empty a { color: var(--sage); }
  @media (max-width: 900px) {
    .fixture { grid-template-columns: 4.5rem minmax(0, 1fr); gap: 1rem 1.2rem; }
    .spots { grid-column: 2; }
    .book { grid-column: 2; display: flex; align-items: center; justify-content: space-between; }
  }

  /* How it works: a real sequence, so it's numbered */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; counter-reset: step; }
  .steps li { display: grid; gap: 0.7rem; align-content: start; padding-top: 1.2rem; border-top: 1px solid var(--olive); counter-increment: step; }
  .steps li::before { content: 'Round ' counter(step); font-size: 0.7rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--olive); font-weight: 600; }
  .steps h3 { font-size: 1.8rem; }
  .steps p { color: var(--mist); }
  @media (max-width: 760px) { .steps { grid-template-columns: 1fr; } }

  /* Gallery */
  .gallery { padding-block: 0 clamp(3.5rem, 8vw, 6rem); }
  .gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 0.8rem; }
  .gallery figure { margin: 0; }
  .gallery img { aspect-ratio: 4 / 5; object-fit: cover; width: 100%; border-radius: 4px; }
  .gallery figcaption { font-size: 0.8rem; color: var(--mist); padding-top: 0.4rem; }

  /* About */
  .about { border-top: 1px solid var(--line); }
  .about-grid { display: grid; }
  .about-copy { display: grid; gap: 1.2rem; align-content: start; max-width: 38rem; }
  .about-copy h2 { font-size: clamp(2.2rem, 5vw, 3.4rem); }
  .about-copy p:last-child { color: var(--mist); }
  @media (max-width: 860px) { .about-grid { grid-template-columns: 1fr; } }

  /* FAQ */
  .faq { background: var(--pine); border-block: 1px solid var(--line); }
  .faq-grid { display: grid; grid-template-columns: 1fr 1.5fr; gap: 2rem 4rem; }
  .faq-list { border-top: 1px solid var(--line); min-width: 0; }
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; padding-block: 1.2rem; font-family: var(--display); font-size: 1.45rem; display: flex; justify-content: space-between; gap: 1rem; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; color: var(--olive); font-family: var(--body); font-weight: 400; }
  details[open] summary::after { content: '–'; }
  details p { padding-bottom: 1.3rem; color: var(--mist); max-width: 38rem; }
  @media (max-width: 860px) { .faq-grid { grid-template-columns: 1fr; } }

  /* Join */
  .join-inner { display: grid; justify-items: center; text-align: center; gap: 1.3rem; }
  .join-inner img { width: 9rem; height: auto; }
  .join h2 { font-size: clamp(2.2rem, 5vw, 3.6rem); max-width: 22ch; }
  .join p { color: var(--mist); max-width: 36rem; }
  .join .hero-cta { justify-content: center; }

</style>
