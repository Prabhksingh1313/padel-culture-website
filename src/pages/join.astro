---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import fb from '../data/firebase.json';

const waBase = site.whatsappNumber ? `https://wa.me/${site.whatsappNumber.replace(/\D/g, '')}` : '';
const joinHref = site.whatsappGroupLink || (waBase ? `${waBase}?text=${encodeURIComponent('Hi! I just signed up on padelculture.in. Please add me to the Padel Culture community.')}` : site.instagram);
---
<Base title="Join Padel Culture | West Delhi padel community" description="Sign up with your mobile number to join Padel Culture's padel community in West Delhi.">
  <script type="application/json" id="fb-config" set:html={JSON.stringify(fb)} />
  <Header />
  <main class="wrap join-page">
    <div class="intro">
      <p class="eyebrow">Join the community</p>
      <h1>Sign up to play.</h1>
      <p>Verify your mobile number once and you're on the Padel Culture list for games, beginner sessions and tournaments in West Delhi.</p>
      <p class="have">Already registered? <a href="/login">Log in with your password</a></p>
    </div>

    <div class="panel" aria-live="polite">
      <!-- Not configured yet -->
      <div id="s-off" hidden>
        <h2>Sign-up opens soon</h2>
        <p class="muted">Until then, message us on WhatsApp and we'll add you.</p>
        <a class="btn btn-solid" href={joinHref} target="_blank" rel="noopener">Message us on WhatsApp</a>
      </div>

      <!-- Step 1: details -->
      <form id="s-details" hidden novalidate>
        <h2>Your details</h2>
        <label for="f-name">Full name</label>
        <input id="f-name" name="name" autocomplete="name" required maxlength="80" placeholder="e.g. Arjun Mehta" />
        <label for="f-phone">Mobile number</label>
        <div class="phone">
          <span>+91</span>
          <input id="f-phone" name="phone" inputmode="numeric" autocomplete="tel-national" required maxlength="10" placeholder="98765 43210" />
        </div>
        <label for="f-pin">PIN code</label>
        <input id="f-pin" name="pincode" inputmode="numeric" autocomplete="postal-code" required maxlength="6" placeholder="e.g. 110058" />
        <label class="check" for="f-consent">
          <input type="checkbox" id="f-consent" required />
          <span>Padel Culture can contact me on this number about games and community updates. See the <a href="/privacy">privacy policy</a>.</span>
        </label>
        <p class="err" id="e-details" hidden></p>
        <button class="btn btn-solid" id="b-send" type="submit">Send OTP</button>
      </form>

      <!-- Step 2: code -->
      <form id="s-code" hidden novalidate>
        <h2>Enter the code</h2>
        <p class="muted">We sent a 6-digit code by SMS to <strong id="t-phone"></strong>.</p>
        <label for="f-code">OTP</label>
        <input id="f-code" class="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="••••••" />
        <p class="err" id="e-code" hidden></p>
        <button class="btn btn-solid" id="b-verify" type="submit">Verify</button>
        <p class="links"><button type="button" class="linkbtn" id="b-change">Change number</button></p>
      </form>

      <!-- Step 3: password -->
      <form id="s-password" hidden novalidate>
        <p class="eyebrow">Number verified</p>
        <h2>Create a password</h2>
        <p class="muted">Next time, log in with your mobile number and this password. No OTP needed.</p>
        <label for="f-pass">Password</label>
        <div class="pass">
          <input id="f-pass" type="password" autocomplete="new-password" minlength="6" maxlength="32" placeholder="At least 6 characters" />
          <button type="button" class="linkbtn" id="b-showpass">Show</button>
        </div>
        <p class="muted hint">At least 6 characters. Numbers only is fine, e.g. a 6-digit PIN.</p>
        <p class="err" id="e-pass" hidden></p>
        <button class="btn btn-solid" id="b-pass" type="submit">Save password</button>
      </form>

      <!-- Step 4: questionnaire -->
      <div id="s-quiz" hidden>
        <p class="eyebrow">Your Padel Culture Rating · <span id="t-qnum">1</span> of <span id="t-qtotal">8</span></p>
        <div class="progress" aria-hidden="true"><i id="t-qbar"></i></div>
        <h2 id="t-question"></h2>
        <p class="muted hint">Answer for a normal game, not your best day.</p>
        <div class="options" id="t-options" role="radiogroup" aria-labelledby="t-question"></div>
        <p class="err" id="e-quiz" hidden></p>
        <p class="links"><button type="button" class="linkbtn" id="b-qback" hidden>Back</button></p>
      </div>

      <!-- Step 5: result -->
      <div id="s-done" hidden>
        <p class="eyebrow" id="t-welcome">You're in</p>
        <div class="rating-card" id="t-card" hidden>
          <span class="rc-label">Your Padel Culture Rating</span>
          <span class="rc-tier" id="t-tier"></span>
          <span class="rc-row"><span class="rc-num" id="t-rating"></span><span class="badge">Provisional</span></span>
          <span class="rc-blurb" id="t-blurb"></span>
        </div>
        <p class="muted" id="t-capnote" hidden>Víbora and Por Tres are earned on court. Play rated games with us to move up.</p>
        <p class="muted">Your number <strong id="t-done-phone"></strong> is verified. Join our WhatsApp community, where new games are posted first.</p>
        <a class="btn btn-solid" href="/leaderboard">See the leaderboard</a>
        <a class="btn btn-ghost" href={joinHref} target="_blank" rel="noopener">Join on WhatsApp</a>
        <p class="links"><button type="button" class="linkbtn" id="b-retake">Retake the questionnaire</button> · <button type="button" class="linkbtn" id="b-logout">Log out</button></p>
      </div>

      <p class="muted loading" id="s-loading">Loading…</p>
      <div id="recaptcha"></div>
    </div>
  </main>
  <Footer />

  <script type="module" is:inline>
    const cfg = JSON.parse(document.getElementById('fb-config').textContent);
    let fb = { ready: false };
    let R = null;
    if (cfg.apiKey) {
      try { fb = await import('/js/firebase.js'); R = await import('/js/rating.js'); }
      catch (e) { console.error(e); }
    }
    const $ = (id) => document.getElementById(id);
    const steps = ['s-off', 's-details', 's-code', 's-password', 's-quiz', 's-done', 's-loading'];
    const show = (id) => steps.forEach((s) => ($(s).hidden = s !== id));
    const err = (id, msg) => { $(id).textContent = msg || ''; $(id).hidden = !msg; };
    const busy = (btn, on, label) => { btn.disabled = on; if (label) btn.textContent = label; };
    let confirmation = null;
    let pending = null;

    let me = { user: null, name: '' };

    async function finish(user) {
      let player = null;
      try { player = await fb.getPlayer(user.uid); } catch (e) {}
      const fields = pending
        ? { name: pending.name, pincode: pending.pincode, consent: true }
        : {};
      if (pending || !player) {
        if (!fields.name) fields.name = (player && player.name) || 'Player';
        await fb.savePlayer(user, fields, !player);
      } else {
        await fb.savePlayer(user, {}, false);
      }
      me = { user, name: (pending && pending.name) || (player && player.name) || '' };
      pending = null;
      me.player = player;
      if (!fb.hasPassword(user)) { show('s-password'); $('f-pass').focus(); return; }
      next();
    }
    function next() {
      const player = me.player;
      if (player && typeof player.rating === 'number') showResult(player.rating, player.tier, false);
      else startQuiz();
    }

    // Password
    $('b-showpass').addEventListener('click', () => {
      const f = $('f-pass');
      f.type = f.type === 'password' ? 'text' : 'password';
      $('b-showpass').textContent = f.type === 'password' ? 'Show' : 'Hide';
    });
    $('s-password').addEventListener('submit', async (e) => {
      e.preventDefault();
      const pw = $('f-pass').value;
      if (pw.length < 6) return err('e-pass', 'Use at least 6 characters. Numbers only is fine.');
      err('e-pass');
      const btn = $('b-pass');
      busy(btn, true, 'Saving…');
      try { await fb.setPassword(me.user, pw); next(); }
      catch (ex) { console.error(ex); err('e-pass', fb.friendlyError(ex)); }
      finally { busy(btn, false, 'Save password'); }
    });

    // Questionnaire
    let qi = 0;
    let answers = {};
    function startQuiz() { qi = 0; answers = {}; renderQ(); show('s-quiz'); }
    function renderQ() {
      const q = R.QUESTIONS[qi];
      $('t-qnum').textContent = qi + 1;
      $('t-qtotal').textContent = R.QUESTIONS.length;
      $('t-qbar').style.width = `${(qi / R.QUESTIONS.length) * 100}%`;
      $('t-question').textContent = q.q;
      $('b-qback').hidden = qi === 0;
      const box = $('t-options');
      box.replaceChildren(...q.a.map((label, i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'option';
        b.setAttribute('role', 'radio');
        b.setAttribute('aria-checked', String(answers[q.id] === i));
        b.textContent = label;
        b.addEventListener('click', () => choose(q.id, i));
        return b;
      }));
    }
    async function choose(id, value) {
      answers[id] = value;
      if (qi < R.QUESTIONS.length - 1) { qi++; renderQ(); return; }
      const result = R.score(answers);
      $('t-options').querySelectorAll('button').forEach((b) => (b.disabled = true));
      err('e-quiz');
      try {
        await fb.saveRating(me.user, R.displayName(me.name), result, answers);
        showResult(result.rating, result.tier, result.capped);
      } catch (ex) {
        console.error(ex);
        err('e-quiz', 'We couldn\'t save your rating. Check your connection and tap your answer again. ' + (ex.code ? `(${ex.code})` : ''));
        $('t-options').querySelectorAll('button').forEach((b) => (b.disabled = false));
      }
    }
    $('b-qback').addEventListener('click', () => { if (qi > 0) { qi--; renderQ(); } });

    function showResult(rating, tierName, capped) {
      const t = R.TIERS.find((x) => x.name === tierName) || R.tierFor(rating);
      const first = me.name ? me.name.split(' ')[0] : '';
      $('t-welcome').textContent = first ? `You're in, ${first}` : "You're in";
      $('t-tier').textContent = t.name;
      $('t-rating').textContent = Number(rating).toFixed(1);
      $('t-blurb').textContent = t.blurb;
      $('t-card').hidden = false;
      $('t-capnote').hidden = !capped;
      $('t-done-phone').textContent = me.user.phoneNumber;
      show('s-done');
    }
    $('b-retake').addEventListener('click', startQuiz);

    if (!fb.ready || !R) show('s-off');
    else {
      let first = true;
      fb.watchUser(async (user) => {
        if (!first) return;
        first = false;
        if (user) { try { await finish(user); } catch (e) { show('s-details'); } }
        else show('s-details');
      });
    }

    $('f-phone').addEventListener('input', (e) => { e.target.value = e.target.value.replace(/\D/g, '').slice(0, 10); });
    $('f-pin').addEventListener('input', (e) => { e.target.value = e.target.value.replace(/\D/g, '').slice(0, 6); });
    $('f-code').addEventListener('input', (e) => { e.target.value = e.target.value.replace(/\D/g, '').slice(0, 6); });

    $('s-details').addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = $('f-name').value.trim();
      const phone = $('f-phone').value.trim();
      if (name.length < 2) return err('e-details', 'Please enter your name.');
      if (!/^[6-9]\d{9}$/.test(phone)) return err('e-details', 'Enter a valid 10-digit Indian mobile number.');
      const pincode = $('f-pin').value.trim();
      if (!/^[1-9]\d{5}$/.test(pincode)) return err('e-details', 'Enter your 6-digit PIN code.');
      if (!$('f-consent').checked) return err('e-details', 'Please tick the box to agree to be contacted.');
      err('e-details');
      const btn = $('b-send');
      busy(btn, true, 'Sending…');
      try {
        confirmation = await fb.sendCode(phone, 'recaptcha');
        pending = { name, pincode };
        $('t-phone').textContent = '+91 ' + phone.replace(/(\d{5})(\d{5})/, '$1 $2');
        show('s-code');
        $('f-code').focus();
      } catch (ex) {
        console.error(ex);
        fb.resetVerifier();
        err('e-details', fb.friendlyError(ex));
      } finally { busy(btn, false, 'Send OTP'); }
    });

    $('s-code').addEventListener('submit', async (e) => {
      e.preventDefault();
      const code = $('f-code').value.trim();
      if (code.length !== 6) return err('e-code', 'Enter the 6-digit code from the SMS.');
      err('e-code');
      const btn = $('b-verify');
      busy(btn, true, 'Verifying…');
      try {
        const res = await confirmation.confirm(code);
        await finish(res.user);
      } catch (ex) {
        console.error(ex);
        err('e-code', fb.friendlyError(ex));
      } finally { busy(btn, false, 'Verify'); }
    });

    $('b-change').addEventListener('click', () => { fb.resetVerifier(); $('f-code').value = ''; err('e-code'); show('s-details'); });
    $('b-logout').addEventListener('click', async () => { await fb.logout(); fb.resetVerifier(); show('s-details'); });
  </script>
</Base>

<style>
  .join-page { display: grid; grid-template-columns: 1fr minmax(0, 28rem); gap: clamp(2rem, 6vw, 5rem); padding-block: clamp(3rem, 8vw, 6rem); align-items: start; }
  .intro { display: grid; gap: 1.2rem; max-width: 30rem; }
  .intro h1 { font-size: clamp(2.8rem, 7vw, 4.8rem); }
  .intro p:not(.eyebrow) { color: var(--mist); }
  .have a { color: var(--sage); font-weight: 500; }
  .panel { background: var(--pine); border: 1px solid var(--line); border-radius: 8px; padding: clamp(1.4rem, 4vw, 2.2rem); min-width: 0; }
  .panel form, .panel > div { display: grid; gap: 0.7rem; }
  .panel h2 { font-size: 2rem; margin-bottom: 0.4rem; }
  label { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--olive); margin-top: 0.5rem; }
  .opt { text-transform: none; letter-spacing: 0; font-weight: 400; color: var(--mist); }
  input, select {
    font: 400 1rem var(--body); color: var(--chalk); background: var(--forest);
    border: 1px solid var(--line); border-radius: 6px; padding: 0.8rem 0.9rem; width: 100%;
  }
  input:focus, select:focus { outline: 2px solid var(--olive); outline-offset: 1px; }
  .phone { display: flex; align-items: stretch; }
  .phone span { display: flex; align-items: center; padding-inline: 0.9rem; background: var(--moss); border: 1px solid var(--line); border-right: 0; border-radius: 6px 0 0 6px; font-weight: 500; }
  .phone input { border-radius: 0 6px 6px 0; min-width: 0; }
  .code { font-size: 1.6rem; letter-spacing: 0.5em; text-align: center; font-variant-numeric: tabular-nums; }
  .check { display: flex; gap: 0.7rem; align-items: flex-start; text-transform: none; letter-spacing: 0; font-weight: 400; font-size: 0.85rem; color: var(--mist); }
  .check input { width: 1.1rem; height: 1.1rem; margin-top: 0.15rem; flex: none; accent-color: var(--olive); }
  .check a { color: var(--sage); }
  .btn { margin-top: 0.8rem; }
  .btn:disabled { opacity: 0.6; cursor: progress; }
  .muted { color: var(--mist); }
  .err { color: #9B2C1F; font-size: 0.9rem; }
  .links { font-size: 0.85rem; color: var(--mist); }
  .links a, .linkbtn { color: var(--sage); }
  .linkbtn { background: none; border: 0; padding: 0; font: inherit; text-decoration: underline; cursor: pointer; }
  .pass { display: flex; align-items: center; gap: 0.6rem; }
  .pass input { flex: 1; min-width: 0; }
  .progress { height: 4px; background: var(--moss); border-radius: 2px; overflow: hidden; }
  .progress i { display: block; height: 100%; background: var(--olive); transition: width 0.3s; }
  .hint { font-size: 0.85rem; }
  .options { display: grid; gap: 0.55rem; margin-top: 0.4rem; }
  .options :global(.option) {
    text-align: left; font: 500 0.95rem/1.4 var(--body); color: var(--chalk);
    background: var(--forest); border: 1px solid var(--line); border-radius: 8px;
    padding: 0.85rem 1rem; cursor: pointer; transition: background 0.15s, border-color 0.15s;
  }
  .options :global(.option:hover) { background: var(--moss); border-color: var(--olive); }
  .options :global(.option[aria-checked="true"]) { border-color: var(--olive); background: var(--moss); }
  .options :global(.option:focus-visible) { outline: 2px solid var(--olive); outline-offset: 2px; }
  .options :global(.option:disabled) { opacity: 0.6; cursor: progress; }
  .rating-card {
    display: grid; gap: 0.35rem; padding: 1.4rem; border-radius: 10px;
    background: var(--chalk); color: var(--forest);
  }
  .rc-label { font-size: 0.68rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--moss); }
  .rc-tier { font-family: var(--display); font-size: 2.6rem; line-height: 1; }
  .rc-row { display: flex; align-items: center; gap: 0.8rem; }
  .rc-num { font-family: var(--display); font-size: 1.8rem; font-variant-numeric: lining-nums tabular-nums; }
  .rc-blurb { font-size: 0.9rem; color: var(--pine); }
  .badge { font-size: 0.65rem; letter-spacing: 0.16em; text-transform: uppercase; padding: 0.25rem 0.55rem; border-radius: 999px; border: 1px solid currentColor; }
  #s-done .btn { margin-top: 0.3rem; }
  @media (max-width: 820px) { .join-page { grid-template-columns: 1fr; } }
</style>
