---
import Base from '../../layouts/Base.astro';
import fb from '../../data/firebase.json';
import { getCollection } from 'astro:content';
const tz = 'Asia/Kolkata';
const games = (await getCollection('games')).map((g) => ({
  id: g.id,
  title: g.data.title,
  when: new Intl.DateTimeFormat('en-IN', { timeZone: tz, weekday: 'short', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' }).format(g.data.date),
  start: g.data.date.toISOString(),
  spots: g.data.spots,
  reserved: g.data.reserved || 0,
}));
---
<Base title="Players | Padel Culture admin" description="Padel Culture players list">
  <meta name="robots" content="noindex" slot="head" />
  <script type="application/json" id="fb-config" set:html={JSON.stringify(fb)} />
  <script type="application/json" id="games-data" set:html={JSON.stringify(games)} />
  <main class="wrap admin">
    <header class="ahead">
      <a href="/" class="brand"><img src="/brand/padel-culture-logo-circle.svg" alt="" width="36" height="36" /> Padel Culture</a>
      <span class="eyebrow">Players</span>
      <button class="linkbtn" id="b-logout" hidden>Log out</button>
    </header>

    <p class="muted" id="s-loading">Loading…</p>
    <p class="muted" id="s-off" hidden>Firebase isn't connected yet, so there are no players to show.</p>

    <!-- Admin login -->
    <div class="login" id="s-login" hidden>
      <h1>Admin login</h1>
      <button class="btn btn-solid" id="b-google" type="button">Sign in with Google</button>
      <a class="btn btn-ghost" href="/join?next=/admin/players">Log in with mobile and password</a>
      <p class="muted or">or get an OTP on your admin mobile number</p>
      <form id="f-send" novalidate>
        <label for="f-phone">Admin mobile number</label>
        <div class="phone"><span>+91</span><input id="f-phone" inputmode="numeric" maxlength="10" autocomplete="tel-national" /></div>
        <button class="btn btn-solid" id="b-send" type="submit">Send OTP</button>
      </form>
      <form id="f-code" hidden novalidate>
        <label for="f-otp">OTP</label>
        <input id="f-otp" inputmode="numeric" maxlength="6" autocomplete="one-time-code" />
        <button class="btn btn-solid" id="b-verify" type="submit">Verify</button>
      </form>
      <p class="err" id="e-login" hidden></p>
    </div>

    <div id="recaptcha"></div>
    <div id="s-denied" hidden class="denied">
      <p class="err" id="t-denied"></p>
      <button class="btn btn-ghost" id="b-switch" type="button">Log out and use another number</button>
    </div>

    <!-- Players table -->
    <section id="s-list" hidden>
      <div class="bar">
        <h1><span id="t-count">0</span> players</h1>
        <input id="f-search" type="search" placeholder="Search name, number or PIN code" aria-label="Search players" />
        <button class="btn btn-ghost" id="b-csv" type="button">Download CSV</button>
      </div>
      <div class="ratings-bar">
        <strong>Ratings</strong>
        <button class="btn btn-ghost" id="b-sheet" type="button">Download ratings sheet</button>
        <label class="btn btn-ghost" for="f-sheet">Upload ratings sheet</label>
        <input id="f-sheet" type="file" accept=".csv,text/csv" hidden />
        <span class="muted">Edit one player with the Edit link, or change the Rating column in the sheet in Excel, save it as CSV and upload it.</span>
      </div>
      <p class="note" id="t-note" hidden></p>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Name</th><th>Mobile</th><th>PIN code</th><th>Rating</th><th>Joined</th><th>Last login</th></tr></thead>
          <tbody id="t-rows"></tbody>
        </table>
      </div>

      <h2 class="bk-title">Bookings</h2>
      <div id="t-bookings" class="bookings"></div>
    </section>
  </main>

  <script type="module" is:inline>
    const cfg = JSON.parse(document.getElementById('fb-config').textContent);
    let fb = { ready: false };
    if (cfg.apiKey) {
      try { fb = await import('/js/firebase.js'); }
      catch (e) { console.error(e); }
    }
    const $ = (id) => document.getElementById(id);
    const views = ['s-loading', 's-off', 's-login', 's-denied', 's-list'];
    const show = (id) => views.forEach((v) => ($(v).hidden = v !== id));
    const err = (msg) => { $('e-login').textContent = msg || ''; $('e-login').hidden = !msg; };
    const fmt = (ts) => ts && ts.toDate ? ts.toDate().toLocaleString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: 'numeric', minute: '2-digit' }) : '';
    const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    let players = [];
    let editing = null;
    const { tierFor, displayName } = await import('/js/rating.js');
    const note = (msg) => { $('t-note').textContent = msg || ''; $('t-note').hidden = !msg; };
    const last10 = (v) => String(v ?? '').replace(/\D/g, '').slice(-10);
    const statusLabel = (p) => (p.ratingStatus === 'verified' ? 'Verified' : 'Provisional');

    async function setRating(p, value, status) {
      const rating = Math.round(value * 10) / 10;
      const tier = tierFor(rating).name;
      await fb.adminSetRating(p.id, displayName(p.name), rating, tier, status);
      Object.assign(p, { rating, tier, ratingStatus: status });
    }

    function ratingCell(p) {
      const rated = typeof p.rating === 'number';
      if (editing === p.id) {
        return `<input id="e-rating" type="number" min="0" max="7" step="0.1" value="${rated ? p.rating : ''}" aria-label="Rating, 0 to 7" />
          <select id="e-status" aria-label="Status"><option value="verified"${p.ratingStatus === 'verified' ? ' selected' : ''}>Verified</option><option value="provisional"${p.ratingStatus === 'verified' ? '' : ' selected'}>Provisional</option></select>
          <button class="linkbtn" type="button" data-save="${esc(p.id)}">Save</button> <button class="linkbtn" type="button" data-cancel="1">Cancel</button>`;
      }
      return `${rated ? `${p.rating.toFixed(1)} · ${esc(p.tier)} · ${statusLabel(p)}` : '<span class="muted">Not rated</span>'} <button class="linkbtn" type="button" data-edit="${esc(p.id)}">Edit</button>`;
    }

    // Minimal CSV reader: handles quoted cells and commas inside quotes.
    function parseCsv(text) {
      const rows = []; let row = [], cell = '', q = false;
      for (let i = 0; i < text.length; i++) {
        const c = text[i];
        if (q) {
          if (c === '"' && text[i + 1] === '"') { cell += '"'; i++; }
          else if (c === '"') q = false;
          else cell += c;
        } else if (c === '"') q = true;
        else if (c === ',') { row.push(cell); cell = ''; }
        else if (c === '\n' || c === '\r') {
          if (c === '\r' && text[i + 1] === '\n') i++;
          row.push(cell); cell = '';
          if (row.some((v) => v.trim() !== '')) rows.push(row);
          row = [];
        } else cell += c;
      }
      row.push(cell);
      if (row.some((v) => v.trim() !== '')) rows.push(row);
      return rows;
    }

    function render() {
      const q = $('f-search').value.trim().toLowerCase();
      const rows = players.filter((p) => !q || [p.name, p.phone, p.pincode, p.area, p.tier].join(' ').toLowerCase().includes(q));
      $('t-count').textContent = rows.length;
      $('t-rows').innerHTML = rows.map((p) => `<tr><td>${esc(p.name)}</td><td><a href="https://wa.me/${esc((p.phone || '').replace('+', ''))}" target="_blank" rel="noopener">${esc(p.phone)}</a></td><td>${esc(p.pincode || p.area)}</td><td>${ratingCell(p)}</td><td>${fmt(p.createdAt)}</td><td>${fmt(p.lastLoginAt)}</td></tr>`).join('')
        || '<tr><td colspan="6" class="muted">No players yet.</td></tr>';
    }

    if (!fb.ready) show('s-off');
    else fb.watchUser(async (user) => {
      $('b-logout').hidden = !user;
      if (!user) return show('s-login');
      const denied = (msg) => { $('t-denied').textContent = msg; show('s-denied'); };
      const who = user.email || user.phoneNumber;
      if (!fb.isAdmin(user)) {
        return denied(`You're logged in as ${who}, which isn't an admin account.`);
      }
      try {
        players = await fb.listPlayers();
        render();
        try { renderBookings(await fb.listAllBookings()); } catch (e) { console.error(e); }
        show('s-list');
      } catch (e) {
        console.error(e);
        const c = (e && e.code) || '';
        if (c.includes('permission-denied')) {
          denied(`You're logged in as ${who}, but the database rules in Firebase don't list this account as an admin yet. Update and publish the Firestore rules, then refresh. (permission-denied)`);
        } else {
          denied(`Couldn't load players. Refresh the page and try again. (${c || 'unknown'})`);
        }
      }
    });

    function renderBookings(bookings) {
      const games = JSON.parse($('games-data').textContent).sort((a, b) => Date.parse(a.start) - Date.parse(b.start));
      const byUid = Object.fromEntries(players.map((p) => [p.id, p]));
      const upcoming = games.filter((g) => Date.parse(g.start) + 3 * 3600e3 > Date.now());
      $('t-bookings').innerHTML = upcoming.map((g) => {
        const list = bookings.filter((b) => b.gameId === g.id);
        const taken = list.length + g.reserved;
        return `<div class="bk-game">
          <h3>${esc(g.title)} <span class="muted">· ${esc(g.when)}</span></h3>
          <p class="muted">${taken} of ${g.spots} spots taken (${list.length} online, ${g.reserved} offline)</p>
          ${list.length ? `<ol>${list.map((b) => { const p = byUid[b.uid] || {}; return `<li>${esc(p.name || b.name)} · <a href="https://wa.me/${esc((p.phone || '').replace('+', ''))}" target="_blank" rel="noopener">${esc(p.phone || '')}</a> · ${b.paid ? 'Paid' : 'Payment due'}</li>`; }).join('')}</ol>` : '<p class="muted">No online bookings yet.</p>'}
        </div>`;
      }).join('') || '<p class="muted">No upcoming games.</p>';
    }

    $('f-phone').addEventListener('input', (e) => { e.target.value = e.target.value.replace(/\D/g, '').slice(0, 10); });
    let confirmation;
    $('f-send').addEventListener('submit', async (e) => {
      e.preventDefault(); err();
      try { confirmation = await fb.sendCode($('f-phone').value, 'recaptcha'); $('f-send').hidden = true; $('f-code').hidden = false; $('f-otp').focus(); }
      catch (ex) { console.error(ex); fb.resetVerifier(); err(fb.friendlyError(ex)); }
    });
    $('f-code').addEventListener('submit', async (e) => {
      e.preventDefault(); err();
      try { await confirmation.confirm($('f-otp').value.trim()); }
      catch (ex) { console.error(ex); err(fb.friendlyError(ex)); }
    });
    $('b-logout').addEventListener('click', () => fb.logout().then(() => location.reload()));
    $('b-google').addEventListener('click', async () => {
      err();
      try { await fb.signInWithGoogle(); }
      catch (ex) {
        console.error(ex);
        const c = (ex && ex.code) || '';
        if (c.includes('popup-closed')) return;
        if (c.includes('operation-not-allowed')) return err('Google sign-in isn\'t switched on in Firebase yet. (operation-not-allowed)');
        if (c.includes('popup-blocked')) return err('Your browser blocked the sign-in window. Allow pop-ups for this site and try again.');
        err(fb.friendlyError(ex));
      }
    });
    $('b-switch').addEventListener('click', () => fb.logout().then(() => location.reload()));
    $('f-search').addEventListener('input', render);

    // Edit one player's rating in the table.
    $('t-rows').addEventListener('click', async (e) => {
      const t = e.target;
      if (!t.dataset) return;
      if (t.dataset.edit) { editing = t.dataset.edit; note(); render(); const el = $('e-rating'); if (el) el.focus(); return; }
      if (t.dataset.cancel) { editing = null; render(); return; }
      if (t.dataset.save) {
        const p = players.find((x) => x.id === t.dataset.save);
        const v = parseFloat($('e-rating').value);
        if (!p || !(v >= 0 && v <= 7)) return note('Enter a rating between 0 and 7.');
        const status = $('e-status').value;
        t.disabled = true;
        try {
          await setRating(p, v, status);
          editing = null;
          note(`Saved: ${p.name} is now ${p.rating.toFixed(1)} · ${p.tier} · ${statusLabel(p)}. The leaderboard is updated.`);
        } catch (ex) {
          console.error(ex);
          note(`Couldn't save the rating. (${(ex && ex.code) || 'unknown'})`);
        }
        render();
      }
    });

    // Ratings sheet: download, edit in Excel, save as CSV, upload.
    const csvCell = (v) => `"${String(v ?? '').replace(/"/g, '""')}"`;
    $('b-sheet').addEventListener('click', () => {
      const lines = [['Name', 'Mobile', 'Rating', 'Status'].map(csvCell).join(',')]
        .concat(players.map((p) => [p.name, last10(p.phone), typeof p.rating === 'number' ? p.rating.toFixed(1) : '', typeof p.rating === 'number' ? statusLabel(p) : ''].map(csvCell).join(',')));
      const url = URL.createObjectURL(new Blob(['\ufeff' + lines.join('\n')], { type: 'text/csv' }));
      const a = Object.assign(document.createElement('a'), { href: url, download: `padel-culture-ratings-${new Date().toISOString().slice(0, 10)}.csv` });
      a.click(); URL.revokeObjectURL(url);
    });
    $('f-sheet').addEventListener('change', async (e) => {
      const file = e.target.files[0];
      e.target.value = '';
      if (!file) return;
      if (!/\.csv$/i.test(file.name)) return note('That file isn\'t a CSV. In Excel, use File → Save As → CSV, then upload that file.');
      const rows = parseCsv((await file.text()).replace(/^\ufeff/, ''));
      const head = (rows.shift() || []).map((h) => h.trim().toLowerCase());
      const iMobile = head.findIndex((h) => h.includes('mobile') || h.includes('phone'));
      const iRating = head.findIndex((h) => h.includes('rating'));
      const iStatus = head.findIndex((h) => h.includes('status'));
      if (iMobile < 0 || iRating < 0) return note('The sheet needs a Mobile column and a Rating column. Download the ratings sheet and edit that.');
      let updated = 0, same = 0, failed = 0; const unknown = [], bad = [];
      note('Updating ratings…');
      for (const r of rows) {
        const mobile = last10(r[iMobile]);
        const raw = String(r[iRating] ?? '').trim();
        if (!raw) continue;
        const p = mobile.length === 10 && players.find((x) => last10(x.phone) === mobile);
        if (!p) { unknown.push(r[iMobile] || '(blank)'); continue; }
        const v = parseFloat(raw);
        if (!(v >= 0 && v <= 7)) { bad.push(p.name); continue; }
        const s = iStatus >= 0 ? String(r[iStatus] ?? '').trim().toLowerCase() : '';
        const status = s.startsWith('verif') ? 'verified' : s.startsWith('prov') ? 'provisional' : (p.ratingStatus || 'provisional');
        if (typeof p.rating === 'number' && Math.abs(p.rating - v) < 0.05 && (p.ratingStatus || 'provisional') === status) { same++; continue; }
        try { await setRating(p, v, status); updated++; } catch (ex) { console.error(ex); failed++; }
      }
      render();
      note([
        `${updated} rating${updated === 1 ? '' : 's'} updated and published to the leaderboard.`,
        same ? `${same} unchanged.` : '',
        unknown.length ? `${unknown.length} mobile number${unknown.length === 1 ? '' : 's'} not found: ${unknown.slice(0, 5).join(', ')}${unknown.length > 5 ? '…' : ''}.` : '',
        bad.length ? `Rating not between 0 and 7 for: ${bad.slice(0, 5).join(', ')}${bad.length > 5 ? '…' : ''}.` : '',
        failed ? `${failed} couldn't be saved.` : '',
      ].filter(Boolean).join(' '));
    });
    $('b-csv').addEventListener('click', () => {
      const cell = (v) => `"${String(v ?? '').replace(/"/g, '""')}"`;
      const lines = [['Name', 'Mobile', 'PIN code', 'Rating', 'Tier', 'Joined', 'Last login'].map(cell).join(',')]
        .concat(players.map((p) => [p.name, p.phone, p.pincode || p.area, p.rating ?? '', p.tier ?? '', fmt(p.createdAt), fmt(p.lastLoginAt)].map(cell).join(',')));
      const url = URL.createObjectURL(new Blob([lines.join('\n')], { type: 'text/csv' }));
      const a = Object.assign(document.createElement('a'), { href: url, download: `padel-culture-players-${new Date().toISOString().slice(0, 10)}.csv` });
      a.click(); URL.revokeObjectURL(url);
    });
  </script>
</Base>

<style>
  .admin { padding-block: 1.5rem 4rem; display: grid; gap: 1.5rem; }
  .ahead { display: flex; align-items: center; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line); }
  .brand { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; font-family: var(--display); font-size: 1.3rem; }
  .ahead .linkbtn { margin-left: auto; }
  h1 { font-size: 2.2rem; }
  .login { display: grid; gap: 0.8rem; max-width: 24rem; }
  .login form { display: grid; gap: 0.6rem; }
  label { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--olive); }
  input { font: 400 1rem var(--body); color: var(--chalk); background: var(--pine); border: 1px solid var(--line); border-radius: 6px; padding: 0.7rem 0.9rem; width: 100%; min-width: 0; }
  .phone { display: flex; }
  .phone span { display: flex; align-items: center; padding-inline: 0.8rem; background: var(--moss); border: 1px solid var(--line); border-right: 0; border-radius: 6px 0 0 6px; }
  .phone input { border-radius: 0 6px 6px 0; }
  .bar { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  .bar input { flex: 1 1 14rem; width: auto; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; }
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; font-variant-numeric: tabular-nums; }
  th, .table-wrap :global(td) { text-align: left; padding: 0.75rem 1rem; border-bottom: 1px solid var(--line); white-space: nowrap; }
  th { font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--olive); background: var(--pine); }
  .table-wrap :global(td a) { color: var(--sage); }
  .muted, .table-wrap :global(.muted) { color: var(--mist); }
  .err { color: #9B2C1F; }
  .ratings-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem; margin-top: 1rem; }
  .ratings-bar .muted { font-size: 0.85rem; flex: 1 1 18rem; }
  .ratings-bar label.btn { cursor: pointer; }
  .note { margin: 0.8rem 0; padding: 0.7rem 1rem; border: 1px solid var(--line); border-radius: 6px; background: var(--pine); }
  .table-wrap :global(.linkbtn) { background: none; border: 0; padding: 0; margin-left: 0.5rem; font: inherit; color: var(--sage); text-decoration: underline; cursor: pointer; }
  .table-wrap :global(td input), .table-wrap :global(td select) { width: auto; max-width: 6.5rem; padding: 0.3rem 0.5rem; font: inherit; color: var(--chalk); background: #fff; border: 1px solid var(--line); border-radius: 4px; }
  .bk-title { font-size: 2rem; margin-top: 2rem; }
  .bookings { display: grid; gap: 1rem; }
  .bookings :global(.bk-game) { padding: 1.2rem; border: 1px solid var(--line); border-radius: 8px; background: var(--pine); display: grid; gap: 0.4rem; }
  .bookings :global(h3) { font-size: 1.4rem; }
  .bookings :global(ol) { margin: 0.3rem 0 0; padding-left: 1.3rem; display: grid; gap: 0.3rem; font-size: 0.9rem; }
  .bookings :global(a) { color: var(--sage); }
  .bookings :global(.muted) { color: var(--mist); font-size: 0.9rem; }
  .or { font-size: 0.85rem; padding-top: 0.6rem; border-top: 1px solid var(--line); margin-top: 0.4rem; }
  .denied { display: grid; gap: 1rem; justify-items: start; max-width: 36rem; }
  .linkbtn { background: none; border: 0; padding: 0; font: inherit; color: var(--sage); text-decoration: underline; cursor: pointer; }
</style>
