---
import Base from '../../layouts/Base.astro';
import fb from '../../data/firebase.json';
import site from '../../data/site.json';
import { getCollection } from 'astro:content';
const tz = 'Asia/Kolkata';
const games = (await getCollection('games')).map((g) => ({
  id: g.id,
  title: g.data.title,
  when: new Intl.DateTimeFormat('en-IN', { timeZone: tz, weekday: 'short', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' }).format(g.data.date),
  start: g.data.date.toISOString(),
  spots: g.data.spots,
  reserved: g.data.reserved || 0,
  venue: g.data.venue,
  price: g.data.price,
  status: g.data.status,
  paymentLink: g.data.paymentLink || (site as { paymentLink?: string }).paymentLink || '',
}));
---
<Base title="Dashboard | Padel Culture admin" description="Padel Culture organiser dashboard">
  <meta name="robots" content="noindex" slot="head" />
  <script type="application/json" id="fb-config" set:html={JSON.stringify(fb)} />
  <script type="application/json" id="games-data" set:html={JSON.stringify(games)} />
  <main class="wrap admin">
    <header class="ahead">
      <a href="/" class="brand"><img src="/brand/padel-culture-logo-circle.svg" alt="" width="36" height="36" /> Padel Culture</a>
      <span class="eyebrow">Dashboard</span>
      <a class="site-admin" href="/admin/">Edit games &amp; site text →</a>
      <button class="linkbtn" id="b-logout" hidden>Log out</button>
    </header>

    <p class="muted" id="s-loading">Loading…</p>
    <p class="muted" id="s-off" hidden>Firebase isn't connected yet, so there are no players to show.</p>

    <!-- Admin login -->
    <div class="login" id="s-login" hidden>
      <h1>Admin login</h1>
      <button class="btn btn-solid" id="b-google" type="button">Sign in with Google</button>
      <a class="btn btn-ghost" href="/join?next=/admin/players">Log in with mobile and password</a>
      <p class="muted or">or get an OTP on your admin mobile number</p>
      <form id="f-send" novalidate>
        <label for="f-phone">Admin mobile number</label>
        <div class="phone"><span>+91</span><input id="f-phone" inputmode="numeric" maxlength="10" autocomplete="tel-national" /></div>
        <button class="btn btn-solid" id="b-send" type="submit">Send OTP</button>
      </form>
      <form id="f-code" hidden novalidate>
        <label for="f-otp">OTP</label>
        <input id="f-otp" inputmode="numeric" maxlength="6" autocomplete="one-time-code" />
        <button class="btn btn-solid" id="b-verify" type="submit">Verify</button>
      </form>
      <p class="err" id="e-login" hidden></p>
    </div>

    <div id="recaptcha"></div>
    <div id="s-denied" hidden class="denied">
      <p class="err" id="t-denied"></p>
      <button class="btn btn-ghost" id="b-switch" type="button">Log out and use another number</button>
    </div>

    <!-- Players table -->
    <section id="s-list" hidden>
      <div class="tabs" role="tablist" aria-label="Dashboard">
        <button type="button" role="tab" class="tab" data-tab="players" aria-selected="true">Players</button>
        <button type="button" role="tab" class="tab" data-tab="bookings" aria-selected="false">Enrollments</button>
        <button type="button" role="tab" class="tab" data-tab="scores" aria-selected="false">Scores &amp; ratings</button>
        <a class="tab tab-link" href="/admin/">Games &amp; site text ↗</a>
      </div>
      <p class="note" id="t-scale" hidden></p>
      <p class="note" id="t-note" hidden></p>

      <div class="tabpanel" id="tab-players">
      <div class="bar">
        <h1><span id="t-count">0</span> players</h1>
        <input id="f-search" type="search" placeholder="Search name, number or PIN code" aria-label="Search players" />
        <button class="btn btn-ghost" id="b-csv" type="button">Download CSV</button>
      </div>
      <div class="ratings-bar">
        <strong>Ratings</strong>
        <button class="btn btn-ghost" id="b-sheet" type="button">Download ratings sheet</button>
        <label class="btn btn-ghost" for="f-sheet">Upload ratings sheet</label>
        <input id="f-sheet" type="file" accept=".csv,text/csv" hidden />
        <span class="muted">Edit one player with the Edit link, or change the Rating column in the sheet in Excel, save it as CSV and upload it.</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Name</th><th>Mobile</th><th>PIN code</th><th>Rating</th><th>Joined</th><th>Last login</th></tr></thead>
          <tbody id="t-rows"></tbody>
        </table>
      </div>

      </div>

      <div class="tabpanel" id="tab-bookings" hidden>
        <h1>Enrollments</h1>
        <p class="muted how">Everyone who booked each game, with payment status. Send each player a WhatsApp confirmation that their slot is booked and when to arrive: tap <strong>Send confirmation</strong> for one player, or <strong>Send to all</strong> to go through them one by one. Each tap opens WhatsApp (or WhatsApp Business) with the message ready, and you press send. Mark players Paid as the money comes in.</p>
        <div id="t-bookings" class="enroll"></div>
      </div>

      <div class="tabpanel" id="tab-scores" hidden>
        <h1>Scores &amp; ratings</h1>
        <p class="muted how">Enter every match from a session. For each match, the team's expected share of points comes from all four players' ratings. Beat that share and your rating goes up; fall short and it goes down. New players move faster, the change per session is capped, and ratings turn Court-Proven after 5 sessions with at least 6 different partners. Players without a rating start at 2.00.</p>
        <div class="sess">
          <label>Session<select id="sc-game"></select></label>
          <label>Name<input id="sc-title" placeholder="e.g. Thursday Night Americano" /></label>
          <label>Date<input id="sc-date" type="date" /></label>
        </div>
        <div class="matches-head"><span>Team A</span><span>Score</span><span></span><span>Score</span><span>Team B</span><span></span></div>
        <div id="sc-matches" class="matches"></div>
        <div class="sc-actions">
          <button type="button" class="btn btn-ghost" id="sc-add">+ Add match</button>
          <button type="button" class="btn btn-solid" id="sc-preview">Preview rating changes</button>
        </div>
        <p class="err" id="sc-err" hidden></p>
        <div id="sc-out" hidden>
          <h2>Rating changes</h2>
          <div class="table-wrap"><table><thead><tr><th>Player</th><th class="num">Matches</th><th class="num">Points</th><th class="num">Share</th><th class="num">Expected</th><th class="num">Change</th><th class="num">Rating</th><th>Level</th></tr></thead><tbody id="sc-rows"></tbody></table></div>
          <div class="sc-actions"><button type="button" class="btn btn-solid" id="sc-apply">Apply and publish to leaderboard</button></div>
        </div>
        <h2 class="bk-title">Past sessions</h2>
        <div id="sc-history" class="bookings"><p class="muted">Loading…</p></div>
      </div>
    </section>
  </main>

  <script type="module" is:inline>
    const cfg = JSON.parse(document.getElementById('fb-config').textContent);
    let fb = { ready: false };
    if (cfg.apiKey) {
      try { fb = await import('/js/firebase.js'); }
      catch (e) { console.error(e); }
    }
    const $ = (id) => document.getElementById(id);
    const views = ['s-loading', 's-off', 's-login', 's-denied', 's-list'];
    const show = (id) => views.forEach((v) => ($(v).hidden = v !== id));
    const err = (msg) => { $('e-login').textContent = msg || ''; $('e-login').hidden = !msg; };
    const fmt = (ts) => ts && ts.toDate ? ts.toDate().toLocaleString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: 'numeric', minute: '2-digit' }) : '';
    const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    let players = [];
    let editing = null;
    const R = await import('/js/rating.js');
    const { tierFor, displayName } = R;
    const note = (msg) => { $('t-note').textContent = msg || ''; $('t-note').hidden = !msg; };
    const last10 = (v) => String(v ?? '').replace(/\D/g, '').slice(-10);
    const statusLabel = (p) => (p.ratingStatus === 'verified' ? 'Court-Proven' : 'Calibrating');

    async function setRating(p, value, status) {
      const rating = Math.round(value * 100) / 100;
      const tier = tierFor(rating).name;
      await fb.adminSetRating(p.id, displayName(p.name), rating, tier, status);
      Object.assign(p, { rating, tier, ratingStatus: status });
    }

    function ratingCell(p) {
      const rated = typeof p.rating === 'number';
      if (editing === p.id) {
        return `<input id="e-rating" type="number" min="0" max="7" step="0.01" value="${rated ? p.rating : ''}" aria-label="Rating, 0 to 7" />
          <select id="e-status" aria-label="Status"><option value="verified"${p.ratingStatus === 'verified' ? ' selected' : ''}>Court-Proven</option><option value="provisional"${p.ratingStatus === 'verified' ? '' : ' selected'}>Calibrating</option></select>
          <button class="linkbtn" type="button" data-save="${esc(p.id)}">Save</button> <button class="linkbtn" type="button" data-cancel="1">Cancel</button>`;
      }
      return `${rated ? `${p.rating.toFixed(2)} · ${esc(p.tier)} · ${statusLabel(p)}` : '<span class="muted">Not rated</span>'} <button class="linkbtn" type="button" data-edit="${esc(p.id)}">Edit</button>`;
    }

    // Minimal CSV reader: handles quoted cells and commas inside quotes.
    function parseCsv(text) {
      const rows = []; let row = [], cell = '', q = false;
      for (let i = 0; i < text.length; i++) {
        const c = text[i];
        if (q) {
          if (c === '"' && text[i + 1] === '"') { cell += '"'; i++; }
          else if (c === '"') q = false;
          else cell += c;
        } else if (c === '"') q = true;
        else if (c === ',') { row.push(cell); cell = ''; }
        else if (c === '\n' || c === '\r') {
          if (c === '\r' && text[i + 1] === '\n') i++;
          row.push(cell); cell = '';
          if (row.some((v) => v.trim() !== '')) rows.push(row);
          row = [];
        } else cell += c;
      }
      row.push(cell);
      if (row.some((v) => v.trim() !== '')) rows.push(row);
      return rows;
    }

    function render() {
      const q = $('f-search').value.trim().toLowerCase();
      const rows = players.filter((p) => !q || [p.name, p.phone, p.pincode, p.area, p.tier].join(' ').toLowerCase().includes(q));
      $('t-count').textContent = rows.length;
      $('t-rows').innerHTML = rows.map((p) => `<tr><td>${esc(p.name)}</td><td><a href="https://wa.me/${esc((p.phone || '').replace('+', ''))}" target="_blank" rel="noopener">${esc(p.phone)}</a></td><td>${esc(p.pincode || p.area)}</td><td>${ratingCell(p)}</td><td>${fmt(p.createdAt)}</td><td>${fmt(p.lastLoginAt)}</td></tr>`).join('')
        || '<tr><td colspan="6" class="muted">No players yet.</td></tr>';
    }

    if (!fb.ready) show('s-off');
    else fb.watchUser(async (user) => {
      $('b-logout').hidden = !user;
      if (!user) return show('s-login');
      const denied = (msg) => { $('t-denied').textContent = msg; show('s-denied'); };
      const who = user.email || user.phoneNumber;
      if (!fb.isAdmin(user)) {
        return denied(`You're logged in as ${who}, which isn't an admin account.`);
      }
      try {
        players = await fb.listPlayers();
        const old = players.filter((x) => typeof x.rating === 'number' && x.scale === 10).length;
        players.forEach((x) => { if (typeof x.rating === 'number') { x.rating = R.normRating(x); x.tier = tierFor(x.rating).name; } });
        if (old) {
          $('t-scale').innerHTML = `${old} rating${old === 1 ? ' is' : 's are'} saved on the 1–10 trial scale. They're shown converted back to 0–7 here and on the leaderboard. <button type="button" class="linkbtn" id="b-convert">Save the converted ratings</button>`;
          $('t-scale').hidden = false;
          $('b-convert').addEventListener('click', async (e) => {
            e.target.disabled = true;
            try {
              const conv = (d) => { const r = R.normRating(d); return { rating: r, tier: tierFor(r).name }; };
              const n = await fb.adminConvertScale(await fb.listPlayers(), await fb.listLeaderboard(), conv);
              $('t-scale').textContent = `Done: ${n} records converted back to the 0–7 scale.`;
            } catch (ex) { console.error(ex); $('t-scale').textContent = `Couldn't convert. (${(ex && ex.code) || 'unknown'})`; }
          });
        }
        render();
        initScores();
        try {
          let wl = [];
          try { wl = await fb.listWaitlist(); } catch (e) { console.error(e); }
          renderBookings(await fb.listAllBookings(), wl);
        } catch (e) { console.error(e); }
        show('s-list');
      } catch (e) {
        console.error(e);
        const c = (e && e.code) || '';
        if (c.includes('permission-denied')) {
          denied(`You're logged in as ${who}, but the database rules in Firebase don't list this account as an admin yet. Update and publish the Firestore rules, then refresh. (permission-denied)`);
        } else {
          denied(`Couldn't load players. Refresh the page and try again. (${c || 'unknown'})`);
        }
      }
    });

    // ---------- Enrollments ----------
    let allBookings = [], allWaitlist = [];
    const DEFAULT_MSG = "Hi {name}! Your slot for {game} {day} at {venue} is confirmed. \u2705\n\nPlease be there sharp by {arrive}, 15 minutes before we start at {start}.\n\nSee you on court!\nPadel Culture";
    let msgTemplate = DEFAULT_MSG;
    try { msgTemplate = localStorage.getItem('pc-msg2') || DEFAULT_MSG; } catch (e) {}
    const links = {};   // gameId -> payment link typed in this session
    const queue = {};   // gameId -> index in "send to all"
    const inr = (n) => '₹' + Number(n || 0).toLocaleString('en-IN');
    const waNum = (phone) => String(phone || '').replace(/\D/g, '');
    const fmtTs = (ts) => ts && ts.toDate ? ts.toDate().toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' }) : '';

    function renderBookings(bookings, waitlist = []) {
      allBookings = bookings; allWaitlist = waitlist;
      const games = JSON.parse($('games-data').textContent).sort((a, b) => Date.parse(a.start) - Date.parse(b.start));
      const byUid = Object.fromEntries(players.map((p) => [p.id, p]));
      const upcoming = games.filter((g) => Date.parse(g.start) + 3 * 3600e3 > Date.now());
      $('t-bookings').innerHTML = upcoming.map((g) => {
        const list = bookings.filter((b) => b.gameId === g.id)
          .sort((a, b) => ((a.createdAt && a.createdAt.toMillis && a.createdAt.toMillis()) || 0) - ((b.createdAt && b.createdAt.toMillis && b.createdAt.toMillis()) || 0));
        const paid = list.filter((b) => b.paid).length;
        const taken = list.length + g.reserved;
        const link = links[g.id] ?? g.paymentLink;
        const wl = waitlist.filter((w) => w.gameId === g.id);
        const rows = list.map((b, i) => {
          const p = byUid[b.uid] || {};
          const lvl = typeof p.rating === 'number' ? `${R.show1(p.rating)} · ${esc(tierFor(p.rating).name)}` : '<span class="muted">Not rated</span>';
          return `<tr class="${b.paid ? 'is-paid' : ''}">
            <td class="num">${i + 1}</td>
            <td><strong>${esc(p.name || b.name)}</strong></td>
            <td><a href="https://wa.me/${esc(waNum(p.phone))}" target="_blank" rel="noopener">${esc(p.phone || '')}</a></td>
            <td>${lvl}</td>
            <td>${esc(fmtTs(b.createdAt))}</td>
            <td><button type="button" class="pill ${b.paid ? 'pill-paid' : 'pill-due'}" data-act="paid" data-id="${esc(b.id)}">${b.paid ? 'Paid ✓' : 'Payment due'}</button></td>
            <td class="acts">
              <a class="linkbtn" data-act="send" data-id="${esc(b.id)}" data-game="${esc(g.id)}" href="${esc(waHref(b, g))}" target="_blank" rel="noopener">${b.linkSentAt ? 'Send again' : 'Send confirmation'}</a>
              ${b.linkSentAt ? `<span class="muted small">sent ${esc(fmtTs(b.linkSentAt))}</span>` : ''}
              <button type="button" class="linkbtn danger" data-act="remove" data-id="${esc(b.id)}">Remove</button>
            </td>
          </tr>`;
        }).join('');
        const unpaid = list.filter((b) => !b.paid);
        const qi = queue[g.id];
        const next = qi != null ? unpaid[qi] : null;
        return `<article class="eg" data-game="${esc(g.id)}">
          <header class="eg-head">
            <div>
              <h3>${esc(g.title)}</h3>
              <p class="muted">${esc(g.when)} · ${esc(g.venue)} · ${inr(g.price)}</p>
            </div>
            <div class="eg-stats">
              <span><strong>${taken}</strong>/${g.spots} spots</span>
              <span><strong>${list.length}</strong> online${g.reserved ? ` · ${g.reserved} offline` : ''}</span>
              <span><strong>${paid}</strong> paid · <strong>${list.length - paid}</strong> due</span>
            </div>
          </header>
          <div class="eg-pay">
            <div class="eg-pay-acts">
              ${unpaid.length ? `<a class="btn btn-solid" data-act="all" data-game="${esc(g.id)}" href="${esc(waHref(next || unpaid[0], g))}" target="_blank" rel="noopener">${next ? `Send to ${esc((byUid[next.uid] || {}).name || next.name)} (${qi + 1} of ${unpaid.length}) →` : `Send to all (${unpaid.length})`}</a>` : '<button type="button" class="btn btn-solid" disabled>Everyone confirmed</button>'}
              ${next ? `<button type="button" class="linkbtn" data-act="stop" data-game="${esc(g.id)}">Stop</button>` : ''}
              <button type="button" class="btn btn-ghost" data-act="csv" data-game="${esc(g.id)}" ${list.length ? '' : 'disabled'}>Download list</button>
            </div>
          </div>
          ${list.length ? `<div class="table-wrap"><table><thead><tr><th class="num">#</th><th>Name</th><th>Mobile</th><th>Level</th><th>Booked</th><th>Payment</th><th></th></tr></thead><tbody>${rows}</tbody></table></div>` : '<p class="muted">No online enrollments yet.</p>'}
          ${wl.length ? `<p class="wl-title">Waitlist (${wl.length}), first to join at the top</p><ol class="wl">${wl.map((w) => { const p = byUid[w.uid] || {}; return `<li>${esc(p.name || w.name)} · <a href="https://wa.me/${esc(waNum(p.phone))}" target="_blank" rel="noopener">${esc(p.phone || '')}</a></li>`; }).join('')}</ol>` : ''}
        </article>`;
      }).join('') || '<p class="muted">No upcoming games.</p>';
      $('t-bookings').insertAdjacentHTML('beforeend', `<details class="msg-edit"><summary>Edit the WhatsApp message</summary>
        <p class="muted small">Use {name}, {game}, {day} (today / tomorrow / date), {venue}, {start}, {arrive} (15 minutes before) and {price}. They're filled in for each player.</p>
        <textarea id="f-msg" rows="6">${esc(msgTemplate)}</textarea>
        <div class="sc-actions"><button type="button" class="btn btn-ghost" id="b-msg-save">Save message</button><button type="button" class="linkbtn" id="b-msg-reset">Reset to default</button></div></details>`);
    }

    const tmFmt = (d) => d.toLocaleTimeString('en-IN', { timeZone: 'Asia/Kolkata', hour: 'numeric', minute: '2-digit', hour12: true }).replace(' am', ' AM').replace(' pm', ' PM');
    function dayWord(start) {
      const k = (d) => d.toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' });
      const today = new Date(), tom = new Date(Date.now() + 864e5);
      if (k(start) === k(today)) return 'today';
      if (k(start) === k(tom)) return 'tomorrow';
      return 'on ' + start.toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata', weekday: 'long', day: 'numeric', month: 'short' });
    }
    function waMessage(b, g) {
      const p = players.find((x) => x.id === b.uid) || {};
      const first = String(p.name || b.name || '').trim().split(/\s+/)[0] || 'there';
      const start = new Date(g.start);
      const arrive = new Date(start.getTime() - 15 * 60e3);
      return msgTemplate.replace(/\{name\}/g, first).replace(/\{game\}/g, g.title).replace(/\{day\}/g, dayWord(start))
        .replace(/\{when\}/g, g.when).replace(/\{venue\}/g, g.venue).replace(/\{start\}/g, tmFmt(start))
        .replace(/\{arrive\}/g, tmFmt(arrive)).replace(/\{price\}/g, inr(g.price));
    }
    function waHref(b, g) {
      const p = players.find((x) => x.id === b.uid) || {};
      const num = waNum(p.phone);
      return num ? `https://wa.me/${num}?text=${encodeURIComponent(waMessage(b, g))}` : '#';
    }
    const gameById = (id) => JSON.parse($('games-data').textContent).find((g) => g.id === id);
    const rerender = () => renderBookings(allBookings, allWaitlist);

    $('t-bookings').addEventListener('input', (e) => {
      if (e.target.classList.contains('f-link')) links[e.target.dataset.game] = e.target.value.trim();
    });
    $('t-bookings').addEventListener('click', async (e) => {
      const t = e.target.closest('[data-act], #b-msg-save, #b-msg-reset');
      if (!t) return;
      if (t.id === 'b-msg-save') { msgTemplate = $('f-msg').value || DEFAULT_MSG; try { localStorage.setItem('pc-msg2', msgTemplate); } catch (x) {} note('Message saved on this device.'); return; }
      if (t.id === 'b-msg-reset') { msgTemplate = DEFAULT_MSG; try { localStorage.removeItem('pc-msg2'); } catch (x) {} rerender(); return; }
      const act = t.dataset.act;
      const b = allBookings.find((x) => x.id === t.dataset.id);
      const card = t.closest('.eg');
      const needLink = (g) => {
        return false;
      };
      const markSent = (bk) => {
        fb.adminUpdateBooking(bk.id, { linkSentAt: new Date() }).catch((x) => console.error(x));
        bk.linkSentAt = { toDate: () => new Date(), toMillis: () => Date.now() };
      };
      try {
        if (act === 'paid' && b) {
          t.disabled = true;
          await fb.adminUpdateBooking(b.id, { paid: !b.paid });
          b.paid = !b.paid; rerender();
        } else if (act === 'send' && b) {
          const g = gameById(t.dataset.game);
          if (needLink(g)) { e.preventDefault(); return; }
          const href = waHref(b, g);
          if (href === '#') { e.preventDefault(); note(`No mobile number saved for ${b.name}.`); return; }
          t.href = href;               // the link opens WhatsApp itself
          markSent(b);
          setTimeout(rerender, 400);
        } else if (act === 'all') {
          const g = gameById(t.dataset.game);
          if (needLink(g)) { e.preventDefault(); return; }
          const unpaid = allBookings.filter((x) => x.gameId === g.id && !x.paid)
            .sort((a, c) => ((a.createdAt && a.createdAt.toMillis && a.createdAt.toMillis()) || 0) - ((c.createdAt && c.createdAt.toMillis && c.createdAt.toMillis()) || 0));
          const i = queue[g.id] ?? 0;
          const cur = unpaid[i];
          if (!cur) { e.preventDefault(); delete queue[g.id]; rerender(); return; }
          t.href = waHref(cur, g);
          if (t.href.endsWith('#')) { e.preventDefault(); note(`No mobile number saved for ${cur.name}.`); }
          else markSent(cur);
          if (i + 1 < unpaid.length) queue[g.id] = i + 1; else { delete queue[g.id]; note(`Confirmation sent to all ${unpaid.length} players for ${g.title}.`); }
          setTimeout(rerender, 400);
        } else if (act === 'stop') {
          delete queue[t.dataset.game]; rerender();
        } else if (act === 'remove' && b) {
          if (t.dataset.confirming !== '1') { t.dataset.confirming = '1'; t.textContent = 'Tap again to remove'; return; }
          t.disabled = true;
          await fb.adminRemoveBooking(b);
          allBookings = allBookings.filter((x) => x.id !== b.id); rerender();
          note(`${b.name} removed. The spot is free again.`);
        } else if (act === 'csv') {
          const g = gameById(t.dataset.game);
          const byUid = Object.fromEntries(players.map((p) => [p.id, p]));
          const list = allBookings.filter((x) => x.gameId === g.id);
          const cell = (v) => `"${String(v ?? '').replace(/"/g, '""')}"`;
          const lines = [['Name', 'Mobile', 'Rating', 'Level', 'Booked', 'Paid', 'Link sent'].map(cell).join(',')].concat(list.map((x) => {
            const p = byUid[x.uid] || {};
            return [p.name || x.name, p.phone, typeof p.rating === 'number' ? R.show1(p.rating) : '', typeof p.rating === 'number' ? tierFor(p.rating).name : '', fmtTs(x.createdAt), x.paid ? 'Yes' : 'No', x.linkSentAt ? 'Yes' : 'No'].map(cell).join(',');
          }));
          const url = URL.createObjectURL(new Blob(['﻿' + lines.join('\n')], { type: 'text/csv' }));
          Object.assign(document.createElement('a'), { href: url, download: `enrollments-${g.id}.csv` }).click();
          URL.revokeObjectURL(url);
        }
      } catch (ex) {
        console.error(ex);
        note(`Couldn't update. (${(ex && ex.code) || 'unknown'})`);
        rerender();
      }
    });

    $('f-phone').addEventListener('input', (e) => { e.target.value = e.target.value.replace(/\D/g, '').slice(0, 10); });
    let confirmation;
    $('f-send').addEventListener('submit', async (e) => {
      e.preventDefault(); err();
      try { confirmation = await fb.sendCode($('f-phone').value, 'recaptcha'); $('f-send').hidden = true; $('f-code').hidden = false; $('f-otp').focus(); }
      catch (ex) { console.error(ex); fb.resetVerifier(); err(fb.friendlyError(ex)); }
    });
    $('f-code').addEventListener('submit', async (e) => {
      e.preventDefault(); err();
      try { await confirmation.confirm($('f-otp').value.trim()); }
      catch (ex) { console.error(ex); err(fb.friendlyError(ex)); }
    });
    $('b-logout').addEventListener('click', () => fb.logout().then(() => location.reload()));
    $('b-google').addEventListener('click', async () => {
      err();
      try { await fb.signInWithGoogle(); }
      catch (ex) {
        console.error(ex);
        const c = (ex && ex.code) || '';
        if (c.includes('popup-closed')) return;
        if (c.includes('operation-not-allowed')) return err('Google sign-in isn\'t switched on in Firebase yet. (operation-not-allowed)');
        if (c.includes('popup-blocked')) return err('Your browser blocked the sign-in window. Allow pop-ups for this site and try again.');
        err(fb.friendlyError(ex));
      }
    });
    $('b-switch').addEventListener('click', () => fb.logout().then(() => location.reload()));
    $('f-search').addEventListener('input', render);

    // ---------- Tabs ----------
    document.querySelectorAll('.tab[data-tab]').forEach((t) => t.addEventListener('click', () => {
      document.querySelectorAll('.tab[data-tab]').forEach((x) => x.setAttribute('aria-selected', String(x === t)));
      document.querySelectorAll('.tabpanel').forEach((pn) => (pn.hidden = pn.id !== 'tab-' + t.dataset.tab));
    }));

    // ---------- Scores & ratings ----------
    const START = R.START_RATING;
    let lastPreview = null;
    function playerOptions(sel) {
      const opts = players.slice().sort((a, b) => String(a.name).localeCompare(String(b.name)))
        .map((x) => `<option value="${esc(x.id)}"${x.id === sel ? ' selected' : ''}>${esc(x.name)} · ${esc(last10(x.phone).slice(-4))}${typeof x.rating === 'number' ? ' · ' + x.rating.toFixed(2) : ''}</option>`).join('');
      return `<option value="">Player…</option>${opts}`;
    }
    function addMatch(m = {}) {
      const row = document.createElement('div');
      row.className = 'match';
      row.innerHTML = `
        <div class="team"><select class="pa1" aria-label="Team A player 1">${playerOptions(m.a && m.a[0])}</select><select class="pa2" aria-label="Team A player 2">${playerOptions(m.a && m.a[1])}</select></div>
        <input class="sa" type="number" min="0" inputmode="numeric" aria-label="Team A points" value="${m.sa ?? ''}" />
        <span class="vs">vs</span>
        <input class="sb" type="number" min="0" inputmode="numeric" aria-label="Team B points" value="${m.sb ?? ''}" />
        <div class="team"><select class="pb1" aria-label="Team B player 1">${playerOptions(m.b && m.b[0])}</select><select class="pb2" aria-label="Team B player 2">${playerOptions(m.b && m.b[1])}</select></div>
        <button type="button" class="linkbtn rm" aria-label="Remove match">✕</button>`;
      row.querySelector('.rm').addEventListener('click', () => { row.remove(); $('sc-out').hidden = true; });
      row.addEventListener('change', () => { $('sc-out').hidden = true; });
      $('sc-matches').appendChild(row);
    }
    function readMatches() {
      const out = [], problems = [];
      [...$('sc-matches').querySelectorAll('.match')].forEach((row, i) => {
        const v = (c) => row.querySelector(c).value;
        const a = [v('.pa1'), v('.pa2')], b = [v('.pb1'), v('.pb2')];
        const sa = parseInt(v('.sa'), 10), sb = parseInt(v('.sb'), 10);
        const blank = ![...a, ...b].some(Boolean) && isNaN(sa) && isNaN(sb);
        if (blank) return;
        if ([...a, ...b].some((x) => !x)) return problems.push(`Match ${i + 1}: choose all four players.`);
        if (new Set([...a, ...b]).size < 4) return problems.push(`Match ${i + 1}: the same player appears twice.`);
        if (isNaN(sa) || isNaN(sb) || sa < 0 || sb < 0 || sa + sb === 0) return problems.push(`Match ${i + 1}: enter both scores.`);
        out.push({ a, b, sa, sb });
      });
      return { matches: out, problems };
    }
    function initScores() {
      const games = JSON.parse($('games-data').textContent).sort((a, b) => Date.parse(b.start) - Date.parse(a.start));
      $('sc-game').innerHTML = games.map((g) => `<option value="${esc(g.id)}">${esc(g.title)} · ${esc(g.when)}</option>`).join('') + '<option value="">Other session</option>';
      const syncGame = () => {
        const g = games.find((x) => x.id === $('sc-game').value);
        if (g) { $('sc-title').value = g.title; $('sc-date').value = g.start.slice(0, 10); }
      };
      $('sc-game').addEventListener('change', syncGame);
      syncGame();
      if (!$('sc-date').value) $('sc-date').value = new Date().toISOString().slice(0, 10);
      $('sc-matches').innerHTML = '';
      for (let i = 0; i < 4; i++) addMatch();
      loadSessions();
    }
    $('sc-add').addEventListener('click', () => addMatch());
    $('sc-preview').addEventListener('click', () => {
      const { matches, problems } = readMatches();
      $('sc-err').hidden = true;
      if (problems.length || !matches.length) {
        $('sc-err').textContent = problems.length ? problems.join(' ') : 'Add at least one match with players and scores.';
        $('sc-err').hidden = false; $('sc-out').hidden = true; return;
      }
      const byId = Object.fromEntries(players.map((x) => [x.id, x]));
      const input = {};
      matches.forEach((m) => [...m.a, ...m.b].forEach((uid) => {
        const x = byId[uid];
        input[uid] = { rating: typeof x.rating === 'number' ? x.rating : START, sessions: x.sessions || 0, status: x.ratingStatus || 'provisional', partners: x.partners || [], unrated: typeof x.rating !== 'number' };
      }));
      const res = R.computeSession(matches, input);
      const list = Object.values(res).sort((a, b) => b.delta - a.delta);
      const pct = (x) => Math.round(x * 100) + '%';
      $('sc-rows').innerHTML = list.map((r) => {
        const x = byId[r.uid];
        return `<tr><td>${esc(x.name)}${input[r.uid].unrated ? ' <span class="muted">(new, from 2.00)</span>' : ''}</td><td class="num">${r.matches}</td><td class="num">${r.won}/${r.played}</td><td class="num">${pct(r.share)}</td><td class="num">${pct(r.expShare)}</td><td class="num ${r.delta > 0 ? 'up' : r.delta < 0 ? 'down' : ''}">${r.delta > 0 ? '+' : ''}${r.delta.toFixed(2)}</td><td class="num">${r.before.toFixed(2)} → <strong>${r.after.toFixed(2)}</strong></td><td>${esc(r.tier)} · ${r.status === 'verified' ? 'Court-Proven' : 'Calibrating'} <span class="muted">${R.FORM_SYMBOL[r.beat]}</span></td></tr>`;
      }).join('');
      lastPreview = { matches, list };
      $('sc-out').hidden = false;
      $('sc-apply').disabled = false;
      $('sc-apply').textContent = 'Apply and publish to leaderboard';
    });
    $('sc-apply').addEventListener('click', async () => {
      if (!lastPreview) return;
      const btn = $('sc-apply');
      btn.disabled = true; btn.textContent = 'Saving…';
      const byId = Object.fromEntries(players.map((x) => [x.id, x]));
      const results = lastPreview.list.map((r) => {
        const x = byId[r.uid];
        const known = new Set(x.partners || []);
        return {
          uid: r.uid, name: displayName(x.name), before: r.before, after: r.after, delta: r.delta, tier: r.tier, status: r.status,
          share: Math.round(r.share * 1000) / 1000, exp: Math.round(r.expShare * 1000) / 1000,
          partnersNew: [...r.partnerSet].filter((u) => !known.has(u)),
          form: [r.beat, ...(x.form || [])].slice(0, 5),
          sessionsAfter: (x.sessions || 0) + 1,
        };
      });
      const session = { title: $('sc-title').value.trim() || 'Session', date: $('sc-date').value, gameId: $('sc-game').value || null, matches: lastPreview.matches };
      try {
        await fb.adminApplySession(results, session);
        results.forEach((r) => Object.assign(byId[r.uid], { rating: r.after, tier: r.tier, ratingStatus: r.status, sessions: r.sessionsAfter, form: r.form, partners: [...(byId[r.uid].partners || []), ...r.partnersNew] }));
        render();
        lastPreview = null;
        btn.textContent = 'Saved ✓';
        note(`Session saved: ${results.length} ratings updated and published to the leaderboard.`);
        $('sc-matches').innerHTML = ''; for (let i = 0; i < 4; i++) addMatch();
        loadSessions();
      } catch (ex) {
        console.error(ex);
        btn.disabled = false; btn.textContent = 'Apply and publish to leaderboard';
        $('sc-err').textContent = (ex && ex.code && ex.code.includes('permission'))
          ? 'The Firestore rules need updating before sessions can be saved. (permission-denied)'
          : `Couldn't save the session. (${(ex && ex.code) || 'unknown'})`;
        $('sc-err').hidden = false;
      }
    });
    async function loadSessions() {
      try {
        const list = await fb.listSessions();
        const byId = Object.fromEntries(players.map((x) => [x.id, x]));
        $('sc-history').innerHTML = list.length ? list.map((s) => {
          const res = Object.entries(s.results || {}).sort((a, b) => b[1].delta - a[1].delta);
          return `<div class="bk-game"><h3>${esc(s.title)} <span class="muted">· ${esc(s.date || '')}</span></h3>
            <p class="muted">${(s.matches || []).length} matches · ${res.length} players</p>
            <ol>${res.map(([uid, r]) => `<li>${esc((byId[uid] || {}).name || 'Player')} · ${Number(r.before).toFixed(2)} → ${Number(r.after).toFixed(2)} (${r.delta > 0 ? '+' : ''}${Number(r.delta).toFixed(2)})</li>`).join('')}</ol></div>`;
        }).join('') : '<p class="muted">No sessions entered yet.</p>';
      } catch (e) {
        console.error(e);
        $('sc-history').innerHTML = '<p class="muted">Past sessions will show here once the updated Firestore rules are published.</p>';
      }
    }

    // Edit one player's rating in the table.
    $('t-rows').addEventListener('click', async (e) => {
      const t = e.target;
      if (!t.dataset) return;
      if (t.dataset.edit) { editing = t.dataset.edit; note(); render(); const el = $('e-rating'); if (el) el.focus(); return; }
      if (t.dataset.cancel) { editing = null; render(); return; }
      if (t.dataset.save) {
        const p = players.find((x) => x.id === t.dataset.save);
        const v = parseFloat($('e-rating').value);
        if (!p || !(v >= 0 && v <= 7)) return note('Enter a rating between 0 and 7.');
        const status = $('e-status').value;
        t.disabled = true;
        try {
          await setRating(p, v, status);
          editing = null;
          note(`Saved: ${p.name} is now ${p.rating.toFixed(2)} · ${p.tier} · ${statusLabel(p)}. The leaderboard is updated.`);
        } catch (ex) {
          console.error(ex);
          note(`Couldn't save the rating. (${(ex && ex.code) || 'unknown'})`);
        }
        render();
      }
    });

    // Ratings sheet: download, edit in Excel, save as CSV, upload.
    const csvCell = (v) => `"${String(v ?? '').replace(/"/g, '""')}"`;
    $('b-sheet').addEventListener('click', () => {
      const lines = [['Name', 'Mobile', 'Rating', 'Status'].map(csvCell).join(',')]
        .concat(players.map((p) => [p.name, last10(p.phone), typeof p.rating === 'number' ? p.rating.toFixed(2) : '', typeof p.rating === 'number' ? statusLabel(p) : ''].map(csvCell).join(',')));
      const url = URL.createObjectURL(new Blob(['\ufeff' + lines.join('\n')], { type: 'text/csv' }));
      const a = Object.assign(document.createElement('a'), { href: url, download: `padel-culture-ratings-${new Date().toISOString().slice(0, 10)}.csv` });
      a.click(); URL.revokeObjectURL(url);
    });
    $('f-sheet').addEventListener('change', async (e) => {
      const file = e.target.files[0];
      e.target.value = '';
      if (!file) return;
      if (!/\.csv$/i.test(file.name)) return note('That file isn\'t a CSV. In Excel, use File → Save As → CSV, then upload that file.');
      const rows = parseCsv((await file.text()).replace(/^\ufeff/, ''));
      const head = (rows.shift() || []).map((h) => h.trim().toLowerCase());
      const iMobile = head.findIndex((h) => h.includes('mobile') || h.includes('phone'));
      const iRating = head.findIndex((h) => h.includes('rating'));
      const iStatus = head.findIndex((h) => h.includes('status'));
      if (iMobile < 0 || iRating < 0) return note('The sheet needs a Mobile column and a Rating column. Download the ratings sheet and edit that.');
      let updated = 0, same = 0, failed = 0; const unknown = [], bad = [];
      note('Updating ratings…');
      for (const r of rows) {
        const mobile = last10(r[iMobile]);
        const raw = String(r[iRating] ?? '').trim();
        if (!raw) continue;
        const p = mobile.length === 10 && players.find((x) => last10(x.phone) === mobile);
        if (!p) { unknown.push(r[iMobile] || '(blank)'); continue; }
        const v = parseFloat(raw);
        if (!(v >= 0 && v <= 7)) { bad.push(p.name); continue; }
        const s = iStatus >= 0 ? String(r[iStatus] ?? '').trim().toLowerCase() : '';
        const status = (s.startsWith('verif') || s.startsWith('court')) ? 'verified' : (s.startsWith('prov') || s.startsWith('calib')) ? 'provisional' : (p.ratingStatus || 'provisional');
        if (typeof p.rating === 'number' && Math.abs(p.rating - v) < 0.005 && (p.ratingStatus || 'provisional') === status) { same++; continue; }
        try { await setRating(p, v, status); updated++; } catch (ex) { console.error(ex); failed++; }
      }
      render();
      note([
        `${updated} rating${updated === 1 ? '' : 's'} updated and published to the leaderboard.`,
        same ? `${same} unchanged.` : '',
        unknown.length ? `${unknown.length} mobile number${unknown.length === 1 ? '' : 's'} not found: ${unknown.slice(0, 5).join(', ')}${unknown.length > 5 ? '…' : ''}.` : '',
        bad.length ? `Rating not between 0 and 7 for: ${bad.slice(0, 5).join(', ')}${bad.length > 5 ? '…' : ''}.` : '',
        failed ? `${failed} couldn't be saved.` : '',
      ].filter(Boolean).join(' '));
    });
    $('b-csv').addEventListener('click', () => {
      const cell = (v) => `"${String(v ?? '').replace(/"/g, '""')}"`;
      const lines = [['Name', 'Mobile', 'PIN code', 'Rating', 'Tier', 'Joined', 'Last login'].map(cell).join(',')]
        .concat(players.map((p) => [p.name, p.phone, p.pincode || p.area, p.rating ?? '', p.tier ?? '', fmt(p.createdAt), fmt(p.lastLoginAt)].map(cell).join(',')));
      const url = URL.createObjectURL(new Blob([lines.join('\n')], { type: 'text/csv' }));
      const a = Object.assign(document.createElement('a'), { href: url, download: `padel-culture-players-${new Date().toISOString().slice(0, 10)}.csv` });
      a.click(); URL.revokeObjectURL(url);
    });
  </script>
