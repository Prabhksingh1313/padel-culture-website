---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import fb from '../data/firebase.json';

const tiers = [
  { name: 'Beginner', range: '0.0–0.9' },
  { name: 'Beginner+', range: '1.0–1.9' },
  { name: 'Intermediate', range: '2.0–2.9' },
  { name: 'Intermediate+', range: '3.0–3.9' },
  { name: 'Lower Advanced', range: '4.0–4.9' },
  { name: 'Advanced', range: '5.0–5.9' },
  { name: 'Elite', range: '6.0–7.0' },
];
---
<Base title="Leaderboard | Padel Culture" description="Padel Culture Rating leaderboard for the West Delhi padel community.">
  <script type="application/json" id="fb-config" set:html={JSON.stringify(fb)} />
  <Header />
  <main class="wrap lb">
    <div class="lb-head">
      <div class="lb-intro">
        <p class="eyebrow">Padel Culture Rating</p>
        <h1>Leaderboard</h1>
        <p>The Padel Culture Rating runs from 0 to 7, the same range as Playtomic, so your Playtomic level means something here too. A short questionnaire sets where you start. After that, every session moves it, based on the points you win against what was expected from your partners' and opponents' levels. It's Calibrating until you've played 5 sessions with 6 different partners, then it's Court-Proven.</p>
        <p class="have" id="t-have">Already registered? <a href="/join?next=/leaderboard">Log in to see your rank</a></p>
      </div>
      <div class="me" id="t-me" hidden>
        <span class="rc-label">Your rating</span>
        <span class="rc-tier" id="t-me-tier"></span>
        <span class="rc-row"><span class="rc-num" id="t-me-rating"></span><span class="badge" id="t-me-status"></span></span>
        <span class="rc-rank" id="t-me-rank"></span>
      </div>
      <a class="cta" id="t-cta" href="/join">
        <span class="rc-label">Not rated yet?</span>
        <span class="cta-title">Get your rating</span>
        <span class="cta-sub">Sign up and answer 13 quick questions →</span>
      </a>
    </div>

    <section class="history" id="s-history" hidden aria-labelledby="h-history">
      <div class="history-head">
        <h2 id="h-history">Your rating over time</h2>
        <p class="muted" id="t-history-read" aria-live="polite"></p>
      </div>
      <div class="report" id="t-report" hidden></div>
      <div id="t-history-chart"></div>
      <p class="muted" id="t-history-note"></p>
      <details>
        <summary>Show as a list</summary>
        <div class="table-wrap"><table><thead><tr><th>Date</th><th class="num">Rating</th><th>Tier</th><th>Status</th><th>From</th></tr></thead><tbody id="t-history-rows"></tbody></table></div>
      </details>
    </section>

    <ol class="ladder" aria-label="Rating tiers">
      {tiers.map((t, i) => (
        <li>
          <button type="button" class="tier" data-tier={t.name} aria-pressed="false">
            <span class="tier-step">{i + 1}</span>
            <span class="tier-name">{t.name}</span>
            <span class="tier-range">({t.range})</span>
            <span class="tier-count" data-count={t.name}>0 players</span>
          </button>
        </li>
      ))}
    </ol>

    <div class="board-bar">
      <p class="muted" id="t-filter">Showing all players</p>
      <button type="button" class="linkbtn" id="b-clear" hidden>Show all tiers</button>
    </div>

    <div class="table-wrap">
      <table>
        <thead><tr><th class="num">#</th><th>Player</th><th>Level</th><th class="num">Rating</th><th>Form</th><th>Status</th></tr></thead>
        <tbody id="t-rows"><tr><td colspan="6" class="muted">Loading…</td></tr></tbody>
      </table>
    </div>
  </main>
  <Footer />

  <script type="module" is:inline>
    const cfg = JSON.parse(document.getElementById('fb-config').textContent);
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    let fb = null;
    let rows = [];
    let filter = '';
    let myId = null;

    function render() {
      const list = filter ? rows.filter((r) => r.tier === filter) : rows;
      $('t-filter').textContent = filter ? `Showing ${filter} players` : `Showing all ${rows.length} players`;
      $('b-clear').hidden = !filter;
      document.querySelectorAll('.tier').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tier === filter)));
      $('t-rows').innerHTML = list.length
        ? list.map((r) => `<tr class="${r.id === myId ? 'you' : ''}">
            <td class="num">${r.rank}</td>
            <td>${esc(r.name)}${r.id === myId ? ' <span class="you-tag">You</span>' : ''}</td>
            <td><span class="chip">${esc(r.tier)}</span></td>
            <td class="num">${R.show1(r.rating)}</td>
            <td><span class="form">${(r.form || []).slice().reverse().map((b) => `<i class="f-${b}">${R.FORM_SYMBOL[b] || ''}</i>`).join('') || '<span class="muted">–</span>'}</span></td>
            <td><span class="status ${r.status === 'verified' ? 'ok' : ''}">${R.confidenceLabel(r)}</span></td>
          </tr>`).join('')
        : `<tr><td colspan="6" class="muted">${rows.length ? 'No players in this tier yet.' : 'No ratings yet. <a href="/join">Be the first to get rated.</a>'}</td></tr>`;
    }

    // ----- Your rating over time (only the logged-in player sees their own) -----
    const R = await import('/js/rating.js');
    const tierName = (r) => R.tierFor(r).name;
    const dateText = (ms) => new Date(ms).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
    const pointText = (p) => `${R.show1(p.r)} · ${tierName(p.r)} · ${p.s === 'verified' ? 'Court-Proven' : 'Calibrating'} · ${dateText(p.at)} · ${p.by === 'organiser' ? 'set by an organiser' : p.by === 'session' ? `after ${p.t || 'a session'} (${p.d >= 0 ? '+' : ''}${Number(p.d || 0).toFixed(2)})` : 'from the questionnaire'}`;

    function drawHistory(player) {
      let pts = Array.isArray(player.ratingHistory) ? player.ratingHistory.filter((p) => typeof p.r === 'number' && typeof p.at === 'number').map((p) => ({ ...p, r: R.normPoint(p) })) : [];
      if (!pts.length && typeof player.rating === 'number') {
        const at = player.ratedAt && player.ratedAt.toMillis ? player.ratedAt.toMillis() : Date.now();
        pts = [{ r: R.normRating(player), s: player.ratingStatus || 'provisional', at, by: 'questionnaire' }];
      }
      if (!pts.length) { $('s-history').hidden = true; return; }
      pts = pts.slice().sort((a, b) => a.at - b.at);
      const W = 640, H = 220, L = 34, R = 52, T = 14, B = 30;
      const rs = pts.map((p) => p.r);
      let lo = Math.max(0, Math.floor(Math.min(...rs) - 0.5)), hi = Math.min(7, Math.ceil(Math.max(...rs) + 0.5));
      if (hi - lo < 2) { if (hi < 7) hi = Math.min(7, lo + 2); else lo = hi - 2; }
      const t0 = pts[0].at, t1 = pts[pts.length - 1].at;
      const x = (p, i) => (t1 === t0 ? (pts.length === 1 ? (L + W - R) / 2 : L + (i / (pts.length - 1)) * (W - L - R)) : L + ((p.at - t0) / (t1 - t0)) * (W - L - R));
      const y = (r) => T + (1 - (r - lo) / (hi - lo)) * (H - T - B);
      const xy = pts.map((p, i) => [x(p, i), y(p.r)]);
      let grid = '';
      for (let v = lo; v <= hi; v++) {
        grid += `<line x1="${L}" x2="${W - R}" y1="${y(v)}" y2="${y(v)}" style="stroke:var(--line)" stroke-width="1"/><text x="${L - 8}" y="${y(v) + 4}" text-anchor="end" font-size="11" style="fill:var(--mist)">${v}</text>`;
      }
      const last = xy[xy.length - 1];
      const line = xy.length > 1 ? `<polyline points="${xy.map((p) => p.join(',')).join(' ')}" fill="none" style="stroke:var(--sage)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>` : '';
      const dots = xy.map(([cx, cy], i) => `<circle cx="${cx}" cy="${cy}" r="5" style="fill:var(--sage);stroke:var(--forest)" stroke-width="2"/><circle class="hit" data-i="${i}" cx="${cx}" cy="${cy}" r="16" fill="transparent" tabindex="0" role="img" aria-label="${esc(pointText(pts[i]))}"/>`).join('');
      const dates = `<text x="${xy[0][0]}" y="${H - 8}" text-anchor="${xy.length > 1 ? 'start' : 'middle'}" font-size="11" style="fill:var(--mist)">${dateText(t0)}</text>` + (t1 !== t0 ? `<text x="${last[0]}" y="${H - 8}" text-anchor="end" font-size="11" style="fill:var(--mist)">${dateText(t1)}</text>` : '');
      $('t-history-chart').innerHTML = `<svg viewBox="0 0 ${W} ${H}" role="group" aria-label="Line chart of your rating over time" style="width:100%;height:auto;max-width:44rem;display:block">${grid}${line}${dots}<text x="${last[0] + 10}" y="${last[1] + 5}" font-size="14" font-weight="600" style="fill:var(--chalk)">${pts[pts.length - 1].r.toFixed(2)}</text>${dates}</svg>`;
      const read = (i) => { $('t-history-read').textContent = pointText(pts[i]); };
      read(pts.length - 1);
      $('t-history-chart').querySelectorAll('.hit').forEach((el) => {
        const on = () => read(Number(el.dataset.i));
        el.addEventListener('pointerenter', on); el.addEventListener('focus', on); el.addEventListener('click', on);
        el.addEventListener('pointerleave', () => read(pts.length - 1));
      });
      const change = pts[pts.length - 1].r - pts[0].r;
      $('t-history-note').textContent = pts.length === 1
        ? 'This is your starting rating. A new point is added every time your rating changes after a game.'
        : `${change === 0 ? 'No change' : (change > 0 ? 'Up ' : 'Down ') + Math.abs(change).toFixed(1)} since ${dateText(t0)}, over ${pts.length} updates. Hover or tap a point for details.`;
      $('t-history-rows').innerHTML = pts.slice().reverse().map((p) => `<tr><td>${dateText(p.at)}</td><td class="num">${R.show1(p.r)}</td><td>${esc(tierName(p.r))}</td><td>${p.s === 'verified' ? 'Court-Proven' : 'Calibrating'}</td><td>${p.by === 'organiser' ? 'Organiser' : p.by === 'session' ? esc(p.t || 'Session') : 'Questionnaire'}</td></tr>`).join('');
      const lastS = pts.slice().reverse().find((p) => p.by === 'session' && typeof p.w === 'number');
      if (lastS) {
        const pc = (x) => Math.round(x * 100) + '%';
        const d = Number(lastS.d || 0);
        $('t-report').innerHTML = `<span class="rep-label">Match report · ${esc(lastS.t || 'Last session')} · ${dateText(lastS.at)}</span>
          <span class="rep-line">You won <strong>${pc(lastS.w)}</strong> of your points. With your partners and opponents, <strong>${pc(lastS.e)}</strong> was expected.</span>
          <span class="rep-delta ${d > 0 ? 'up' : d < 0 ? 'down' : ''}">${d > 0 ? '+' : d < 0 ? '−' : '±'}${Math.abs(d).toFixed(2)}</span>`;
        $('t-report').hidden = false;
      } else $('t-report').hidden = true;
      $('s-history').hidden = false;
    }

    document.querySelectorAll('.tier').forEach((b) => b.addEventListener('click', () => {
      filter = filter === b.dataset.tier ? '' : b.dataset.tier;
      render();
    }));
    $('b-clear').addEventListener('click', () => { filter = ''; render(); });

    async function load() {
      if (!cfg.apiKey) { rows = []; render(); return; }
      try {
        fb = await import('/js/firebase.js');
        const data = (await fb.listLeaderboard())
          .map((r) => { const rating = R.normRating(r); return { ...r, rating, tier: R.tierFor(rating).name }; })
          .sort((a, b) => b.rating - a.rating);
        rows = data.map((r, i) => ({ ...r, rank: i + 1 }));
        // Same rating shares a rank
        rows.forEach((r, i) => { if (i > 0 && r.rating === rows[i - 1].rating) r.rank = rows[i - 1].rank; });
        document.querySelectorAll('[data-count]').forEach((el) => {
          const n = rows.filter((r) => r.tier === el.dataset.count).length;
          el.textContent = `${n} player${n === 1 ? '' : 's'}`;
        });
        render();
        fb.watchUser((user) => {
          myId = user ? user.uid : null;
          const mine = rows.find((r) => r.id === myId);
          $('t-me').hidden = !mine;
          $('t-cta').hidden = Boolean(mine);
          $('t-have').hidden = Boolean(user);
          if (mine) {
            $('t-me-tier').textContent = R.levelWithRange(R.tierFor(mine.rating));
            $('t-me-rating').textContent = R.show1(mine.rating);
            $('t-me-status').textContent = R.confidenceLabel(mine);
            $('t-me-rank').textContent = `Ranked #${mine.rank} of ${rows.length}`;
          }
          render();
          $('s-history').hidden = true;
          if (user) fb.getPlayer(user.uid).then((p) => { if (p) drawHistory(p); }).catch((e) => console.error(e));
        });
      } catch (e) {
        console.error(e);
        $('t-rows').innerHTML = `<tr><td colspan="6" class="muted">Couldn't load the leaderboard. Refresh to try again. (${esc(e.code || 'error')})</td></tr>`;
      }
    }
    load();
  </script>
</Base>

<style>
  .lb { display: grid; gap: 2rem; padding-block: clamp(2.5rem, 7vw, 5rem); }
  .report { display: grid; grid-template-columns: 1fr auto; gap: 0.3rem 1rem; align-items: center; padding: 1rem 1.2rem; background: #fff; border: 1px solid var(--line); border-left: 3px solid var(--olive); border-radius: 10px; }
  .report[hidden] { display: none; }
  .report :global(.rep-label) { grid-column: 1 / -1; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--olive); }
  .report :global(.rep-line) { color: var(--mist); font-size: 0.92rem; }
  .report :global(.rep-delta) { font-family: var(--display); font-size: 1.8rem; color: var(--chalk); }
  .report :global(.rep-delta.up) { color: #2F6B2A; }
  .report :global(.rep-delta.down) { color: #9B2C1F; }
  .rc-pt { font-size: 0.8rem; color: var(--mist); }
  .table-wrap :global(.form) { display: inline-flex; gap: 0.2rem; font-size: 0.75rem; }
  .table-wrap :global(.f-up) { color: #2F6B2A; font-style: normal; }
  .table-wrap :global(.f-down) { color: #9B2C1F; font-style: normal; }
  .table-wrap :global(.f-par) { color: var(--mist); font-style: normal; }
  .history { display: grid; gap: 0.8rem; padding: 1.4rem; border: 1px solid var(--line); border-radius: 8px; background: var(--pine); }
  .history-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 1.5rem; }
  .history h2 { font-size: 1.8rem; }
  .history .muted { font-size: 0.9rem; }
  .history summary { cursor: pointer; font-size: 0.9rem; color: var(--sage); }
  .history details .table-wrap { margin-top: 0.8rem; }
  .history :global(.hit) { cursor: pointer; outline-offset: 2px; }
  .lb-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 20rem); gap: 2rem; align-items: end; }
  .lb-intro { display: grid; gap: 1rem; max-width: 36rem; }
  .lb-intro h1 { font-size: clamp(2.8rem, 7vw, 4.6rem); }
  .lb-intro p:not(.eyebrow) { color: var(--mist); }
  .have a { color: var(--sage); font-weight: 500; }
  .me, .cta { display: grid; gap: 0.35rem; padding: 1.4rem; border-radius: 10px; background: var(--chalk); color: var(--forest); text-decoration: none; }
  .cta:hover { background: var(--sage); }
  .rc-label { font-size: 0.68rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--moss); }
  .rc-tier, .cta-title { font-family: var(--display); font-size: 2.3rem; line-height: 1; }
  .rc-row { display: flex; align-items: center; gap: 0.8rem; }
  .rc-num { font-family: var(--display); font-size: 1.7rem; font-variant-numeric: lining-nums tabular-nums; }
  .rc-rank, .cta-sub { font-size: 0.85rem; color: var(--pine); }
  .badge { font-size: 0.65rem; letter-spacing: 0.16em; text-transform: uppercase; padding: 0.25rem 0.55rem; border-radius: 999px; border: 1px solid currentColor; }

  .ladder { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 0.5rem; }
  .tier {
    width: 100%; height: 100%; display: grid; gap: 0.2rem; text-align: left; cursor: pointer;
    padding: 0.9rem; border-radius: 8px; border: 1px solid var(--line); background: var(--pine); color: var(--chalk);
    font: inherit; transition: background 0.15s, border-color 0.15s;
  }
  .tier:hover { border-color: var(--olive); }
  .tier[aria-pressed="true"] { background: var(--chalk); color: var(--forest); border-color: var(--chalk); }
  .tier:focus-visible { outline: 2px solid var(--olive); outline-offset: 2px; }
  .tier-step { font-size: 0.65rem; letter-spacing: 0.2em; color: var(--olive); font-weight: 600; }
  .tier[aria-pressed="true"] .tier-step { color: var(--moss); }
  .tier-name { font-family: var(--display); font-size: 1.35rem; line-height: 1.1; }
  .tier-range { font-size: 0.75rem; font-variant-numeric: tabular-nums; opacity: 0.8; }
  .tier-count { font-size: 0.72rem; opacity: 0.75; }
  @media (max-width: 1000px) { .ladder { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .lb-head { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .ladder { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .board-bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: -1rem; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; }
  table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  th, .table-wrap :global(td) { text-align: left; padding: 0.8rem 1rem; border-bottom: 1px solid var(--line); white-space: nowrap; }
  .table-wrap :global(tbody tr:last-child td) { border-bottom: 0; }
  th { font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--olive); background: var(--pine); font-weight: 600; }
  .table-wrap :global(.num) { text-align: right; font-variant-numeric: tabular-nums; width: 4rem; }
  .table-wrap :global(td.num:first-child) { font-family: var(--display); font-size: 1.2rem; text-align: left; }
  .table-wrap :global(tr.you td) { background: var(--moss); }
  .table-wrap :global(.you-tag) { font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase; background: var(--chalk); color: var(--forest); padding: 0.15rem 0.45rem; border-radius: 999px; margin-left: 0.3rem; }
  .table-wrap :global(.chip) { font-size: 0.72rem; letter-spacing: 0.06em; padding: 0.25rem 0.6rem; border-radius: 999px; background: var(--moss); }
  .table-wrap :global(.status) { font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mist); }
  .table-wrap :global(.status.ok) { color: var(--sage); font-weight: 600; }
  .muted { color: var(--mist); }
  .table-wrap :global(.muted), .muted { color: var(--mist); }
  .table-wrap :global(.muted a), .linkbtn { color: var(--sage); }
  .linkbtn { background: none; border: 0; padding: 0; font: inherit; text-decoration: underline; cursor: pointer; }
</style>
