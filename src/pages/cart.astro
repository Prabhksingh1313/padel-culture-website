---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import fb from '../data/firebase.json';
import site from '../data/site.json';

const tz = 'Asia/Kolkata';
const fmt = (d: Date, o: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat('en-IN', { timeZone: tz, ...o }).format(d);
const games = (await getCollection('games'))
  .filter((g) => g.data.status !== 'cancelled')
  .map((g) => ({
    id: g.id,
    title: g.data.title,
    when: `${fmt(g.data.date, { weekday: 'short', day: 'numeric', month: 'short' })} · ${fmt(g.data.date, { hour: 'numeric', minute: '2-digit', hour12: true })}${g.data.endTime ? ` – ${g.data.endTime}` : ''}`,
    start: g.data.date.toISOString(),
    venue: `${g.data.venue}, ${g.data.area}`,
    format: g.data.format,
    level: g.data.level,
    price: g.data.price,
    // Spots that can be booked online = total minus those taken offline.
    capacity: Math.max(0, g.data.spots - (g.data.reserved || 0)),
    closed: g.data.status === 'full',
  }));
const waNumber = site.whatsappNumber.replace(/\D/g, '');
---
<Base title="Cart | Padel Culture" description="Your Padel Culture game bookings.">
  <script type="application/json" id="fb-config" set:html={JSON.stringify(fb)} />
  <script type="application/json" id="games-data" set:html={JSON.stringify(games)} />
  <Header />
  <main class="wrap cart-page">
    <div class="head">
      <p class="eyebrow">Bookings</p>
      <h1>Your cart</h1>
    </div>

    <div class="layout">
      <section class="items" aria-labelledby="h-items">
        <h2 id="h-items" class="sr">Games in your cart</h2>
        <ul id="t-items" class="list"></ul>
        <p class="empty" id="t-empty" hidden>Your cart is empty. <a href="/#games">Pick a game</a></p>

        <div id="t-mine-wrap" hidden>
          <h2 class="sub">Your booked games</h2>
          <ul id="t-mine" class="list"></ul>
        </div>
      </section>

      <aside class="summary" id="t-summary" hidden>
        <p class="eyebrow">Summary</p>
        <dl>
          <div><dt>Games</dt><dd id="t-count">0</dd></div>
          <div class="total"><dt>Total</dt><dd id="t-total">₹0</dd></div>
        </dl>
        <p class="err" id="e-checkout" hidden></p>
        <a class="btn btn-solid" id="b-login" href="/join?next=/cart" hidden>Log in / Join to book</a>
        <button class="btn btn-solid" id="b-confirm" type="button" hidden>Confirm booking</button>
        <button class="btn btn-ghost" type="button" disabled title="Online payment is coming soon">Pay online · coming soon</button>
        <p class="muted small">Your spot is held as soon as you confirm. Online payment is coming soon; until then, pay the host at the venue or by UPI.</p>
      </aside>
    </div>

    <div class="done" id="t-done" hidden>
      <p class="eyebrow">Booked</p>
      <h2>You're on the list.</h2>
      <p class="muted" id="t-done-text"></p>
      <p class="muted small">Payment: online payment is coming soon. For now, pay the host at the venue or by UPI. Questions? WhatsApp us at <span class="sel">+{waNumber}</span>.</p>
      <a class="btn btn-solid" href="/#games">Back to games</a>
    </div>
  </main>
  <Footer />

  <script type="module" is:inline>
    import * as cart from '/js/cart.js';
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const games = JSON.parse($('games-data').textContent);
    const byId = Object.fromEntries(games.map((g) => [g.id, g]));
    const cfg = JSON.parse($('fb-config').textContent);
    const inr = (n) => '₹' + Number(n).toLocaleString('en-IN');
    const past = (g) => Date.parse(g.start) + 3 * 3600e3 < Date.now();

    let fb = null, user = null, playerName = '';
    let counts = {}, myBookings = [];

    function left(g) { return Math.max(0, g.capacity - ((counts[g.id] && counts[g.id].booked) || 0)); }

    function render() {
      // Drop games that no longer exist, are over, or are already booked.
      const mineIds = new Set(myBookings.map((b) => b.gameId));
      const ids = cart.get().filter((id) => byId[id] && !past(byId[id]) && !mineIds.has(id));
      if (ids.length !== cart.get().length) { cart.replace(ids); return; }
      const items = ids.map((id) => byId[id]);

      $('t-items').innerHTML = items.map((g) => {
        const l = left(g);
        const full = g.closed || l <= 0;
        return `<li class="item">
          <div class="item-main">
            <h3>${esc(g.title)}</h3>
            <p class="muted">${esc(g.when)} · ${esc(g.venue)}</p>
            <p class="tags"><span>${esc(g.format)}</span><span>${esc(g.level)}</span></p>
            <p class="${full ? 'warn' : 'muted'} small">${full ? 'This game is full. Remove it to continue.' : `${l} spot${l === 1 ? '' : 's'} left`}</p>
          </div>
          <div class="item-side">
            <span class="price">${inr(g.price)}</span>
            <button type="button" class="linkbtn" data-remove="${esc(g.id)}">Remove</button>
          </div>
        </li>`;
      }).join('');
      $('t-empty').hidden = items.length > 0;
      $('t-summary').hidden = items.length === 0;
      $('t-count').textContent = items.length;
      $('t-total').textContent = inr(items.reduce((s, g) => s + g.price, 0));
      $('b-login').hidden = Boolean(user) || !fb;
      $('b-confirm').hidden = !user;
      $('b-confirm').disabled = items.some((g) => g.closed || left(g) <= 0);
      $('t-items').querySelectorAll('[data-remove]').forEach((b) => b.addEventListener('click', () => cart.remove(b.dataset.remove)));

      const mine = myBookings.filter((b) => byId[b.gameId] && !past(byId[b.gameId]));
      $('t-mine-wrap').hidden = mine.length === 0;
      $('t-mine').innerHTML = mine.map((b) => {
        const g = byId[b.gameId];
        return `<li class="item">
          <div class="item-main">
            <h3>${esc(g.title)}</h3>
            <p class="muted">${esc(g.when)} · ${esc(g.venue)}</p>
            <p class="small"><span class="pill">${b.paid ? 'Paid' : 'Reserved · payment due'}</span></p>
          </div>
          <div class="item-side">
            <span class="price">${inr(g.price)}</span>
            <button type="button" class="linkbtn" data-cancel="${esc(g.id)}">Remove me</button>
          </div>
        </li>`;
      }).join('');
      $('t-mine').querySelectorAll('[data-cancel]').forEach((b) => b.addEventListener('click', () => cancel(b.dataset.cancel, b)));
    }

    async function refresh() {
      if (!fb) return render();
      try { counts = await fb.listGameCounts(); } catch (e) { console.error(e); }
      if (user) { try { myBookings = await fb.listMyBookings(user.uid); } catch (e) { console.error(e); } }
      render();
    }

    async function cancel(id, btn) {
      if (btn.dataset.confirming !== '1') {
        btn.dataset.confirming = '1';
        btn.textContent = 'Tap again to cancel';
        return;
      }
      btn.disabled = true;
      try { await fb.cancelBooking(user, id); await refresh(); }
      catch (e) { console.error(e); btn.disabled = false; btn.textContent = 'Couldn\'t cancel. Try again'; }
    }

    $('b-confirm').addEventListener('click', async () => {
      const btn = $('b-confirm');
      const ids = cart.get();
      btn.disabled = true; btn.textContent = 'Booking…';
      $('e-checkout').hidden = true;
      const okTitles = [], problems = [];
      for (const id of ids) {
        const g = byId[id];
        try {
          await fb.bookGame(user, playerName, id, g.capacity);
          cart.remove(id);
          okTitles.push(g.title);
        } catch (e) {
          console.error(e);
          if (e.code === 'already-booked') cart.remove(id);
          problems.push(`${g.title}: ${fb.friendlyError(e)}`);
        }
      }
      btn.textContent = 'Confirm booking';
      await refresh();
      if (problems.length) {
        $('e-checkout').textContent = problems.join(' ');
        $('e-checkout').hidden = false;
      }
      if (okTitles.length && !problems.length) {
        $('t-done-text').textContent = `Your spot is booked for: ${okTitles.join(', ')}.`;
        document.querySelector('.layout').hidden = true;
        document.querySelector('.head').hidden = true;
        $('t-done').hidden = false;
      }
    });

    window.addEventListener('cart-change', render);
    render();

    if (cfg.apiKey) {
      try {
        fb = await import('/js/firebase.js');
        const R = await import('/js/rating.js');
        fb.watchUser(async (u) => {
          user = u;
          playerName = '';
          if (u) {
            try { const p = await fb.getPlayer(u.uid); playerName = R.displayName(p && p.name); } catch (e) { playerName = 'Player'; }
          }
          await refresh();
        });
      } catch (e) { console.error(e); fb = null; render(); }
    }
  </script>
</Base>

<style>
  .cart-page { display: grid; gap: 2rem; padding-block: clamp(2.5rem, 7vw, 5rem); }
  .head { display: grid; gap: 0.8rem; }
  .head h1 { font-size: clamp(2.8rem, 7vw, 4.4rem); }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 22rem); gap: 2rem; align-items: start; }
  .items { padding-block: 0; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .items :global(.item) { display: flex; justify-content: space-between; gap: 1rem; padding-block: 1.3rem; border-bottom: 1px solid var(--line); }
  .items :global(.item-main) { display: grid; gap: 0.35rem; min-width: 0; }
  .items :global(.item h3) { font-size: 1.6rem; }
  .items :global(.item-side) { display: grid; justify-items: end; align-content: start; gap: 0.5rem; }
  .items :global(.price) { font-family: var(--display); font-size: 1.6rem; font-variant-numeric: lining-nums; }
  .items :global(.tags) { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .items :global(.tags span) { font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; padding: 0.25rem 0.55rem; border-radius: 999px; background: var(--moss); }
  .items :global(.pill) { font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.25rem 0.6rem; border-radius: 999px; border: 1px solid var(--olive); color: var(--sage); }
  .items :global(.warn) { color: #9B2C1F; }
  .items :global(.muted), .muted { color: var(--mist); }
  .items :global(.small), .small { font-size: 0.85rem; }
  .items :global(.linkbtn), .linkbtn { background: none; border: 0; padding: 0; font: inherit; font-size: 0.85rem; color: var(--sage); text-decoration: underline; cursor: pointer; }
  .sub { font-size: 1.8rem; margin: 2.5rem 0 1rem; }
  .empty { color: var(--mist); padding-block: 1.5rem; }
  .empty a { color: var(--sage); font-weight: 500; }
  .summary { display: grid; gap: 0.8rem; padding: 1.5rem; background: var(--pine); border: 1px solid var(--line); border-radius: 8px; position: sticky; top: calc(env(safe-area-inset-top, 0px) + 5rem); }
  dl { margin: 0; display: grid; gap: 0.5rem; }
  dl div { display: flex; justify-content: space-between; }
  dt { color: var(--mist); }
  dd { margin: 0; font-variant-numeric: tabular-nums; }
  .total { padding-top: 0.6rem; border-top: 1px solid var(--line); }
  .total dd { font-family: var(--display); font-size: 1.8rem; }
  .btn:disabled { opacity: 0.55; cursor: not-allowed; }
  .err { color: #9B2C1F; font-size: 0.9rem; }
  .done { display: grid; gap: 1rem; justify-items: start; max-width: 36rem; }
  .done h2 { font-size: clamp(2.4rem, 6vw, 3.6rem); }
  .sel { user-select: all; font-weight: 600; }
  @media (max-width: 820px) { .layout { grid-template-columns: 1fr; } .summary { position: static; } }
</style>
