---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import fb from '../data/firebase.json';
---
<Base title="Log in | Padel Culture" description="Log in to Padel Culture with your mobile number and password to see your rating and rank.">
  <script type="application/json" id="fb-config" set:html={JSON.stringify(fb)} />
  <Header />
  <main class="wrap login-page">
    <div class="intro">
      <p class="eyebrow">Members</p>
      <h1>Log in.</h1>
      <p>Use your mobile number and the password you created when you registered.</p>
      <p>New here? <a href="/join">Register and get your rating</a></p>
    </div>

    <div class="panel" aria-live="polite">
      <p class="muted" id="s-loading">Loading…</p>

      <div id="s-off" hidden>
        <h2>Log-in isn't available yet</h2>
        <p class="muted">Please try again later.</p>
      </div>

      <!-- Already logged in -->
      <div id="s-in" hidden>
        <p class="eyebrow">You're logged in</p>
        <h2 id="t-in-name">Welcome back.</h2>
        <p class="muted">Logged in as <strong id="t-in-phone"></strong>.</p>
        <a class="btn btn-solid" href="/leaderboard">See my rank</a>
        <p class="links"><button type="button" class="linkbtn" id="b-logout">Log out</button></p>
      </div>

      <!-- Password login -->
      <form id="s-login" hidden novalidate>
        <h2>Mobile and password</h2>
        <label for="f-phone">Mobile number</label>
        <div class="phone">
          <span>+91</span>
          <input id="f-phone" inputmode="numeric" autocomplete="username" maxlength="10" placeholder="98765 43210" />
        </div>
        <label for="f-pass">Password</label>
        <div class="pass">
          <input id="f-pass" type="password" autocomplete="current-password" maxlength="32" />
          <button type="button" class="linkbtn" id="b-showpass">Show</button>
        </div>
        <p class="err" id="e-login" hidden></p>
        <button class="btn btn-solid" id="b-login" type="submit">Log in</button>
        <p class="links"><button type="button" class="linkbtn" id="b-forgot">Forgot password? Reset it with an OTP</button></p>
      </form>

      <!-- Reset: phone -->
      <form id="s-reset" hidden novalidate>
        <h2>Reset your password</h2>
        <p class="muted">We'll send an OTP to your registered mobile number.</p>
        <label for="f-rphone">Mobile number</label>
        <div class="phone">
          <span>+91</span>
          <input id="f-rphone" inputmode="numeric" autocomplete="tel-national" maxlength="10" placeholder="98765 43210" />
        </div>
        <p class="err" id="e-reset" hidden></p>
        <button class="btn btn-solid" id="b-rsend" type="submit">Send OTP</button>
        <p class="links"><button type="button" class="linkbtn" id="b-back">Back to log in</button></p>
      </form>

      <!-- Reset: code -->
      <form id="s-rcode" hidden novalidate>
        <h2>Enter the code</h2>
        <p class="muted">We sent a 6-digit code to <strong id="t-rphone"></strong>.</p>
        <label for="f-rcode">OTP</label>
        <input id="f-rcode" class="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="••••••" />
        <p class="err" id="e-rcode" hidden></p>
        <button class="btn btn-solid" id="b-rverify" type="submit">Verify</button>
      </form>

      <!-- Reset: new password -->
      <form id="s-newpass" hidden novalidate>
        <h2>New password</h2>
        <label for="f-newpass">Password</label>
        <input id="f-newpass" type="password" autocomplete="new-password" minlength="6" maxlength="32" placeholder="At least 6 characters" />
        <p class="muted hint">At least 6 characters. Numbers only is fine.</p>
        <p class="err" id="e-newpass" hidden></p>
        <button class="btn btn-solid" id="b-newpass" type="submit">Save and log in</button>
      </form>

      <div id="recaptcha"></div>
    </div>
  </main>
  <Footer />

  <script type="module" is:inline>
    const cfg = JSON.parse(document.getElementById('fb-config').textContent);
    let fb = { ready: false };
    if (cfg.apiKey) {
      try { fb = await import('/js/firebase.js'); }
      catch (e) { console.error(e); }
    }
    const $ = (id) => document.getElementById(id);
    const views = ['s-loading', 's-off', 's-in', 's-login', 's-reset', 's-rcode', 's-newpass'];
    const show = (id) => views.forEach((v) => ($(v).hidden = v !== id));
    const err = (id, msg) => { $(id).textContent = msg || ''; $(id).hidden = !msg; };
    const busy = (btn, on, label) => { btn.disabled = on; if (label) btn.textContent = label; };
    const digits = (el, n) => el.addEventListener('input', () => { el.value = el.value.replace(/\D/g, '').slice(0, n); });
    // Where to go after logging in: ?next=/admin/players, otherwise the leaderboard.
    const nextParam = new URLSearchParams(location.search).get('next');
    const nextUrl = nextParam && nextParam.startsWith('/') && !nextParam.startsWith('//') ? nextParam : '/leaderboard';

    async function showIn(user) {
      $('t-in-phone').textContent = user.phoneNumber || '';
      try {
        const p = await fb.getPlayer(user.uid);
        if (p && p.name) $('t-in-name').textContent = `Welcome back, ${p.name.split(' ')[0]}.`;
      } catch (e) {}
      show('s-in');
    }

    if (!fb.ready) show('s-off');
    else {
      let first = true;
      fb.watchUser((user) => {
        if (!first) return;
        first = false;
        if (user) showIn(user); else show('s-login');
      });
    }

    digits($('f-phone'), 10); digits($('f-rphone'), 10); digits($('f-rcode'), 6);
    $('b-showpass').addEventListener('click', () => {
      const f = $('f-pass');
      f.type = f.type === 'password' ? 'text' : 'password';
      $('b-showpass').textContent = f.type === 'password' ? 'Show' : 'Hide';
    });

    $('s-login').addEventListener('submit', async (e) => {
      e.preventDefault();
      const phone = $('f-phone').value, pw = $('f-pass').value;
      if (!/^[6-9]\d{9}$/.test(phone)) return err('e-login', 'Enter your 10-digit mobile number.');
      if (!pw) return err('e-login', 'Enter your password.');
      err('e-login');
      const btn = $('b-login');
      busy(btn, true, 'Logging in…');
      try { await fb.loginWithPassword(phone, pw); location.href = nextUrl; }
      catch (ex) { console.error(ex); err('e-login', fb.friendlyError(ex)); busy(btn, false, 'Log in'); }
    });

    $('b-forgot').addEventListener('click', () => { $('f-rphone').value = $('f-phone').value; show('s-reset'); });
    $('b-back').addEventListener('click', () => show('s-login'));

    let confirmation;
    $('s-reset').addEventListener('submit', async (e) => {
      e.preventDefault();
      const phone = $('f-rphone').value;
      if (!/^[6-9]\d{9}$/.test(phone)) return err('e-reset', 'Enter your 10-digit mobile number.');
      err('e-reset');
      const btn = $('b-rsend');
      busy(btn, true, 'Sending…');
      try {
        confirmation = await fb.sendCode(phone, 'recaptcha');
        $('t-rphone').textContent = '+91 ' + phone.replace(/(\d{5})(\d{5})/, '$1 $2');
        show('s-rcode');
        $('f-rcode').focus();
      } catch (ex) { console.error(ex); fb.resetVerifier(); err('e-reset', fb.friendlyError(ex)); }
      finally { busy(btn, false, 'Send OTP'); }
    });

    $('s-rcode').addEventListener('submit', async (e) => {
      e.preventDefault();
      const code = $('f-rcode').value;
      if (code.length !== 6) return err('e-rcode', 'Enter the 6-digit code from the SMS.');
      err('e-rcode');
      const btn = $('b-rverify');
      busy(btn, true, 'Verifying…');
      try {
        const res = await confirmation.confirm(code);
        const player = await fb.getPlayer(res.user.uid).catch(() => null);
        if (!player) {
          // Not registered yet: send them through sign-up.
          location.href = '/join';
          return;
        }
        show('s-newpass');
        $('f-newpass').focus();
      } catch (ex) { console.error(ex); err('e-rcode', fb.friendlyError(ex)); }
      finally { busy(btn, false, 'Verify'); }
    });

    $('s-newpass').addEventListener('submit', async (e) => {
      e.preventDefault();
      const pw = $('f-newpass').value;
      if (pw.length < 6) return err('e-newpass', 'Use at least 6 characters. Numbers only is fine.');
      err('e-newpass');
      const btn = $('b-newpass');
      busy(btn, true, 'Saving…');
      try { await fb.setPassword(fb.currentUser(), pw); location.href = nextUrl; }
      catch (ex) { console.error(ex); err('e-newpass', fb.friendlyError(ex)); busy(btn, false, 'Save and log in'); }
    });

    $('b-logout').addEventListener('click', async () => { await fb.logout(); show('s-login'); });
  </script>
</Base>

<style>
  .login-page { display: grid; grid-template-columns: 1fr minmax(0, 26rem); gap: clamp(2rem, 6vw, 5rem); padding-block: clamp(3rem, 8vw, 6rem); align-items: start; }
  .intro { display: grid; gap: 1.2rem; max-width: 30rem; }
  .intro h1 { font-size: clamp(2.8rem, 7vw, 4.8rem); }
  .intro p:not(.eyebrow) { color: var(--mist); }
  .intro a { color: var(--sage); font-weight: 500; }
  .panel { background: var(--pine); border: 1px solid var(--line); border-radius: 8px; padding: clamp(1.4rem, 4vw, 2.2rem); min-width: 0; }
  .panel form, .panel > div { display: grid; gap: 0.7rem; }
  .panel h2 { font-size: 2rem; margin-bottom: 0.4rem; }
  label { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--olive); margin-top: 0.5rem; }
  input { font: 400 1rem var(--body); color: var(--chalk); background: var(--forest); border: 1px solid var(--line); border-radius: 6px; padding: 0.8rem 0.9rem; width: 100%; min-width: 0; }
  input:focus { outline: 2px solid var(--olive); outline-offset: 1px; }
  .phone { display: flex; }
  .phone span { display: flex; align-items: center; padding-inline: 0.9rem; background: var(--moss); border: 1px solid var(--line); border-right: 0; border-radius: 6px 0 0 6px; font-weight: 500; }
  .phone input { border-radius: 0 6px 6px 0; }
  .pass { display: flex; align-items: center; gap: 0.6rem; }
  .pass input { flex: 1; }
  .code { font-size: 1.6rem; letter-spacing: 0.5em; text-align: center; font-variant-numeric: tabular-nums; }
  .btn { margin-top: 0.8rem; }
  .btn:disabled { opacity: 0.6; cursor: progress; }
  .muted { color: var(--mist); }
  .hint { font-size: 0.85rem; }
  .err { color: #9B2C1F; font-size: 0.9rem; }
  .links { font-size: 0.85rem; color: var(--mist); }
  .linkbtn { background: none; border: 0; padding: 0; font: inherit; color: var(--sage); text-decoration: underline; cursor: pointer; text-align: left; }
  @media (max-width: 820px) { .login-page { grid-template-columns: 1fr; } }
</style>
